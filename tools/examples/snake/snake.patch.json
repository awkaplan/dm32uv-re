      "cflags": [],
      "link_address": "0x030e91a0",
      "defsym": {"HANDLER": "@snake_category_entry", "EPILOGUE": "@STOCK_CASE_TAIL"},
      "entry": "snake_tail_stub",
      "expect_entry": "0x030e91a0",
      "sections": [".text"]
