    } reg_09h @ 0x12;

    reg {
        name = "Status";
        desc = "Status. First register of every read transfer. The stock driver reads only this register (2 bytes, 0x03065638); its caller, the seek poll at 0x03065bb8, accepts the result when (high byte & 0x60) == 0x40 (STC = 1, SF = 0), then sets the stored frequency (IRAM 0x00040104, 10 kHz units) to READCHAN x 5 + 6500 or + 7600 according to the band flag, redraws it, and saves it to flash block 4 +0x702 as BCD (0x03065918). The init table also writes 0x0000 here (a status register; whether the write has any effect is not documented).";
        ds_ref = "RDA5807M v1.0, 2.5 p.5; 6 p.11-12";
        fw_reads = "0x03065638 (2 bytes), tested at 0x03065bb8";
        confidence = "CONFIRMED";
        wire_addr = 0x0a;
        default sw = r;
        default hw = w;
        field {
            name = "RDSR";
            desc = "1 = a new RDS/RBDS group is ready.";
            ds_ref = "RDA5807M v1.0, 6, p.11";
            confidence = "DATASHEET";
        } rdsr[15:15] = 0;
        field {
            name = "STC";
            desc = "Seek/tune complete. Stock tests it (with SF) at 0x03065bb8.";
            ds_ref = "RDA5807M v1.0, 6, p.11";
            fw_reads = "0x03065bb8: (byte & 0x60) == 0x40";
            confidence = "CONFIRMED";
        } stc[14:14] = 0;
        field {
            name = "SF";
            desc = "Seek fail: 1 = no channel with RSSI above the threshold was found.";
            ds_ref = "RDA5807M v1.0, 6, p.11";
            fw_reads = "0x03065bb8: must be 0";
            confidence = "CONFIRMED";
        } sf[13:13] = 0;
        field {
            name = "RDSS";
            desc = "RDS decoder synchronized (RDS verbose mode only).";
            ds_ref = "RDA5807M v1.0, 6, p.11";
            confidence = "DATASHEET";
        } rdss[12:12] = 0;
        field {
            name = "BLK_E";
            desc = "With RDS enabled: 1 = block E found.";
            ds_ref = "RDA5807M v1.0, 6, p.11-12";
            confidence = "DATASHEET";
        } blk_e[11:11] = 0;
        field {
            name = "ST";
            desc = "Stereo indicator: 0 = mono, 1 = stereo. Stock does not use it.";
            ds_ref = "RDA5807M v1.0, 6, p.12";
            confidence = "DATASHEET";
        } st[10:10] = 1;
        field {
            name = "READCHAN";
            desc = "Current channel, same formula as 03H CHAN; updated after a tune or seek.";
            ds_ref = "RDA5807M v1.0, 6, p.12";
            fw_reads = "0x03065bb8: & 0x3ff, x 5 + 6500 or 7600";
            confidence = "CONFIRMED";
        } readchan[9:0] = 0;
    } reg_0ah @ 0x14;

    reg {
        name = "RSSI / RDS status";
        desc = "RSSI and station flags. Never read by the stock driver (it stops after 0AH).";
        ds_ref = "RDA5807M v1.0, 6, p.12-13";
        confidence = "DATASHEET";
        wire_addr = 0x0b;
        default sw = r;
        default hw = w;
        field {
            name = "RSSI";
            desc = "RSSI, logarithmic. A 7-bit field, but the table lists 000000 = min, 111111 = max.";
            ds_ref = "RDA5807M v1.0, 6, p.12";
            confidence = "DATASHEET";
        } rssi[15:9] = 0;
        field {
            name = "FM_TRUE";
            desc = "1 = the current channel is a station.";
            ds_ref = "RDA5807M v1.0, 6, p.12";
            confidence = "DATASHEET";
        } fm_true[8:8] = 0;
        field {
            name = "FM_READY";
            desc = "1 = ready.";
            ds_ref = "RDA5807M v1.0, 6, p.12";
            confidence = "DATASHEET";
        } fm_ready[7:7] = 0;
        field {
            name = "RSVD6_5";
            desc = "Reserved.";
            ds_ref = "RDA5807M v1.0, 6, p.12";
            confidence = "DATASHEET";
        } rsvd6_5[6:5] = 0;
        field {
            name = "ABCD_E";
            desc = "1 = registers 0CH-0FH hold block E; 0 = blocks A-D.";
            ds_ref = "RDA5807M v1.0, 6, p.12";
            confidence = "DATASHEET";
        } abcd_e[4:4];
        field {
            name = "BLERA";
            desc = "Block errors of RDS block A (or E): 00 none, 01 1-2 corrected, 10 3-5 corrected, 11 6+ or uncorrectable. RDS verbose mode only.";
            ds_ref = "RDA5807M v1.0, 6, p.12";
            confidence = "DATASHEET";
        } blera[3:2];
        field {
            name = "BLERB";
