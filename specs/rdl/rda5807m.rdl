    } reg_0bh @ 0x16;

    reg {
        name = "RDSA";
        desc = "RDS block A (block E in RBDS mode when ABCD_E = 1). Not used by stock (RDS_EN = 0); the init table writes 0x0000 here.";
        ds_ref = "RDA5807M v1.0, 6, p.13";
        confidence = "DATASHEET";
