    reg {
        name = "RDSC";
        desc = "RDS block C (or E). Not used by stock; the init table writes 0x0000 here.";
        ds_ref = "RDA5807M v1.0, 6, p.13";
        confidence = "DATASHEET";
        wire_addr = 0x0e;
        field { name = "RDSC"; desc = "RDS block C data."; ds_ref = "RDA5807M v1.0, 6, p.13"; confidence = "DATASHEET"; sw = r; hw = w; } rdsc[15:0] = 0x5808;
