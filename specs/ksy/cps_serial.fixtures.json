      "offset": 0,
      "length": 141,
      "root_type": "radio_frames_info",
      "note": "Constructed replies to the debug sub-ids; 0x40 carries the first 64 bytes of the derived stock IRAM image",
      "expect": {
        "frames[0].body.length": 4,
        "frames[1].body.length": 64,
        "frames[2].body.sub_id": "patch_flash_read_next"
      }
    }
  ],
  "private_globs": [
    {
      "glob": "cps-captures/*.txt",
      "stream": "host"
    },
    {
      "glob": "cps-captures/*.txt",
      "stream": "radio",
      "root_type": "radio_session"
    }
  ]
