{
  "generic": [
    {
      "path": "specs/ksy/fixtures/cps_host_session.bin",
      "offset": 0,
      "length": 4247,
      "note": "Constructed host side of an OEM-order session: handshake, 16 V-frames, 0x47, PROGRAM, 4 reads, 1 sentinel write",
      "expect": {
        "handshake[0].text": "PSEARCH",
        "handshake[2].text": "SYSINFO",
        "info_frames[0].body.sub_id": "table_0d",
        "info_frames[0].body.arg_c": 64,
        "info_frames[1].body.sub_id": "firmware_version",
        "info_frames[16].code": "g_read",
        "info_frames[16].body.length": 256,
        "info_frames[17].body.ignored": 12,
        "frames[0].body.addr": "0x278000",
        "frames[1].body.addr": "0x1fff",
        "frames[2].body.length": 4096,
        "frames[3].body.is_sentinel": true,
        "frames[4].code": "write",
        "frames[4].body.header.is_sentinel": true
      }
    },
    {
      "path": "specs/ksy/fixtures/cps_radio_session.bin",
      "offset": 0,
      "length": 8749,
      "root_type": "radio_session",
      "note": "Constructed radio side; V-frame values from the stock image, V-frame 0x02 / 0x47 data / block data are placeholders",
      "expect": {
