        "info_replies[0].body.length": 64,
        "info_replies[1].body.payload.text": "DM32.00.01.048",
        "info_replies[3].body.payload.text": "2022-06-27",
        "info_replies[10].body.payload.start": "0x1000",
        "info_replies[10].body.payload.end": "0xc8fff",
        "info_replies[14].body.payload.start": "0x278000",
        "info_replies[15].body.payload.count": 50000,
        "info_replies[16].code": "g_reply",
        "info_replies[17].code": "ack",
        "frames[0].body.echo.length": 4,
        "frames[3].body.echo.is_sentinel": true,
        "frames[4].code": "ack"
      }
    },
    {
      "path": "specs/ksy/fixtures/cps_debug_host.bin",
      "offset": 0,
      "length": 15,
      "root_type": "host_frames_info",
      "note": "Constructed: this project's debug sub-ids 0x3f, 0x40, 0x3e (patched firmware only)",
      "expect": {
        "frames[0].body.sub_id": "patch_ramdump_reset",
        "frames[2].body.sub_id": "patch_flash_read_next"
