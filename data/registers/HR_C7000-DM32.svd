    </peripheral>
    <peripheral>
      <name>ADC</name>
      <description>CPU-side 10-bit ADC controller, 8 channels A-H in pairs per data register (DS §5.9, p.400-423). Distinct from the baseband RX ADC (SystemControl.ADC_CONTROL). FW: 23 sites in 2 code regions, reading all four data registers. The stock per-channel reader table at 0x030ada14 reads channel C as ADC_DATA_CD &amp; 0x3ff (QEMU: dm32_adc.c). Which signal each channel carries on the DM-32 is not established here.</description>
      <groupName>ADC</groupName>
      <baseAddress>0x140d0000</baseAddress>
      <addressBlock><offset>0x0</offset><size>0x10000</size><usage>registers</usage></addressBlock>
      <interrupt><name>ADC</name><description>PIC source 26 (bit 26 of PIC_MASK/INT_ST), default CPU vector 58 (DS Table 30, p.168-169)</description><value>26</value></interrupt>
      <registers>
        <register>
          <name>ADC_CTRL</name>
          <description>ADC Control registers. DS §5.9.5.1 p.411. FW: 0 reads, 3 writes. Reset 0x0 (DS).</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PD_FORCE_HIGH</name>
              <description>Write 1 to soft reset the ADC and controller. For normal operation, write 0 to clear it . [reset 0x0] [access RW]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MODE_SEL</name>
              <description>Scan mode selection. 0 : Single scan; 1 : Continuous scan [reset 0x0] [access RW]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>GLITCH</name>
              <description>Whether to filter burrs. 0 : Do not filter burrs; 1 : Filter burrs. ( Single scan does not filter burrs. Need to filter burrs ) [reset 0x0] [access RW]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>POWER_DOWN</name>
              <description>Whether to support low power mode. 0 : not supported; 1 : supported [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ADC_INTR_DELTA</name>
          <description>ADC Interruption error range. DS §5.9.5.2 p.411. Reset 0x0 (DS).</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ADC_DATA_DELTA</name>
              <description>Set the interrupt error range. The controller can trigger data interrupt and output data only when the difference between the sampled data and the ADC_INTR_THRESHOLE (0x24) register configuration value is greater than ( not equal to ) . Figure 50 . [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>10</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ADC_INTR</name>
