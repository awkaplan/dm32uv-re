              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RX_DONE</name>
              <description>When I2C is used as a slave transmitter, if the master does not have an ACK sent byte, this position is 1 , indicating the end of transmission. [reset 0x0] [access RO]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
