              <name>clk_source</name>
              <description>Select each SD The driving clock of the memory has the following relationship 00b : Select Clock divider_0 , 01 : Select Clock divider_1 , 10b : Select Clock divider_2 , 11 : Select Clock divider_3 , each controller in the project only contains clk_divder0 , which is fixed to 0 [reset 0x0] [access RO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
