          </fields>
        </register>
        <register>
          <name>CTYPE</name>
          <description>Card Type Register. DS §5.5.5.7 p.309. Reset 0x0 (DS).</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>card_width1</name>
              <description>Indicates whether each memory card is 8-bit type 0 : non- 8-bit Type; 1 : 8-bit If there is no 8-bit application in the type project , write all 0s in this segment. [reset 0x0] [access RW]</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>card_width0</name>
              <description>Indicates whether each memory card is 1-bit or 4-bit type 0 : 1-bit Type ; 1 : 4-bit type The project only configures bit[0] and all other bits are written to 0 [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BLKSIZ</name>
          <description>Block size register. DS §5.5.5.8 p.310. Reset 0x200 (DS).</description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000200</resetValue>
          <fields>
            <field>
              <name>block_size</name>
              <description>Block size (bytes ) [reset 0x200] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BYTCNT</name>
          <description>Byte Count Register. DS §5.5.5.9 p.310. Reset 0x200 (DS).</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000200</resetValue>
          <fields>
            <field>
              <name>byte_count</name>
              <description>The number of bytes of data to be transferred For unknown data size transmission, 0 must be written [reset 0x200] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INTMASK</name>
          <description>Interrupt Mask Register. DS §5.5.5.10 p.311. Reset 0x0 (DS).</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>sdio_int_mask</name>
              <description>Shield 16 SDIO memory card Interrupt, 0 : mask; 1 : enable The project only configures bit[16] , and all other bits are written to 0 [reset 0x0] [access RW]</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>int_mask</name>
              <description>Shield unwanted interrupts, 0 : Shield; 1 : Enable bit15 : End-bit error(read)/Write no CRC(EBE) bit14: Auto Command Done(ACD) bit13: Start Bit Error(SBE)/Busy Complete Iterrupt(BCI) bit12: Hardware Locked write Error(HLE) bit11: FIFO underrun/overrun Error(FRUN) bit10: Data starvation-by-host timeout(HTO)/Volt_switch_int bit9: Data Read Timeout(DRTO) bit8: Response Timeout(RTO) bit7: Data CRC Error(DCRC) bit6: Responese CRC Error (RCRC) bit5: Receive FIFO Data Request(RXDR) bit4: Transmit FIFO Data Request(TXDR) bit3: Data Transfer Over(DTO) bit2: Command done(CD) bit1: Response Error(RE) bit0: Card Detect(CD) [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CMDARG</name>
          <description>Instruction content segment register. DS §5.5.5.11 p.311. Reset 0x0 (DS).</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>cmd_arg</name>
              <description>32bit transmitted to the card Instruction content [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CMD</name>
          <description>Command register. DS §5.5.5.12 p.311. Reset 0x20000000 (DS).</description>
          <addressOffset>0x2c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x20000000</resetValue>
          <fields>
            <field>
              <name>start_cmd</name>
              <description>Send instructions, CIU After receiving the instruction, this bit is automatically cleared [reset 0x0] [access RW]</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>use_hold_reg</name>
              <description>0 : CMD and DATA Not through HOLD Registers sent to memory card 1 : CMD and DATA through HOLD Register sent to memory card [reset 0x1] [access RW]</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>volt_switch</name>
              <description>0 : No voltage switching 1 : Voltage switching enabled, send CMD11 Must be set when [reset 0x0] [access RW]</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>boot_mode</name>
              <description>Boot Mode selection: 0 : Must boot operate 1 : Optional boot operate [reset 0x0] [access RW]</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>disable_boot</name>
              <description>Boot invalid [reset 0x0] [access RW]</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>expect_boot_ack</name>
              <description>( CIU ) hopes to obtain boot Response [reset 0x0] [access RW]</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>enable_boot</name>
              <description>Enable boot [reset 0x0] [access RW]</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ccs_expected</name>
              <description>0 : CE_ATA The interrupt in the device is invalid, or the command does not need to get the device CCS (Command Complete Signal .) 1 : CE_ATA Device internal interrupt enable, RW_BLK Need from CE_ATA The device's CCS (Command Completion Signal .) If there is no CE-ATA application, this bit is written as 0. [reset 0x0] [access RW]</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>read_ceata_device</name>
              <description>0 : The host does not send data to CE_ATA. Device reads data 1 : Master end to CE-ATA If the device reads data without CE- ATA application, this bit is written as 0. [reset 0x0] [access RW]</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>update_clock_registers_only</name>
              <description>0 : Normal instruction sequence 1 : Do not send instructions, only update the clock register [reset 0x0] [access RW]</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>card_number</name>
              <description>Current valid card number [reset 0x0] [access RW]</description>
              <bitOffset>16</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>send_initialization</name>
              <description>0 : Do not send the initialization sequence before sending the command 1 : Send initialization sequence before sending command 80 must be executed before sending any command to the card. c l o c k s Initialize the card. [reset 0x0] [access RW]</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>stop_abort_cmd</name>
              <description>0 : Do not stop or abandon the current data transfer 1 : Stop or abandon the current data transmission [reset 0x0] [access RW]</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>wait_prvdata_complete</name>
              <description>0 : Send new command regardless of whether the previous data transmission is completed 1 : Wait for the last data transmission to complete before sending a new command [reset 0x0] [access RW]</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>send_auto_stop</name>
              <description>0 : After data transmission is completed, no (automatic) stop command is issued 1 : After data transmission is completed, a (automatic) stop command is issued [reset 0x0] [access RW]</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>transfer_mode</name>
              <description>0 : Data block transmission instruction; 1 : Data stream transmission instruction [reset 0x0] [access RW]</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>read_write</name>
              <description>0 : read; 1 : write [reset 0x0] [access RW]</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>data_expected</name>
              <description>0 : No data reading or writing; 1 : Data reading or writing [reset 0x0] [access RW]</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>check_response_crc</name>
              <description>0 : No CRC response Check; 1 : Perform reply CRC check [reset 0x0] [access RW]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>response_length</name>
              <description>0 : short reply; 1 : long reply [reset 0x0] [access RW]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>response_expect</name>
              <description>0 : No reply; 1 : Reply [reset 0x0] [access RW]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>cmd_index</name>
              <description>Instruction number [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RESP0</name>
          <description>Response reply register 0. DS §5.5.5.13 p.314. Reset 0x0 (DS).</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
