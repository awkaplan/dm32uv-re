              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DAC_PD_B</name>
              <description>DAC channel B power on and off control. 1 : Power off; 0 : Power on [reset 0x1] [access RW]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DAC_PD_A</name>
              <description>DAC channel A power on and off control. 1 : Power off; 0 : Power on [reset 0x1] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DAC_PD_MODE_EN</name>
          <description>DAC Low power enable. DS §5.10.5.2 p.423. FW: 0 reads, 1 write. Reset 0x7 (DS).</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000007</resetValue>
          <fields>
