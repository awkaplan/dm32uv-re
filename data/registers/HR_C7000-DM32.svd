<?xml version="1.0" encoding="utf-8"?>
<!--
  HR_C7000 (Baofeng DM-32UV) CMSIS-SVD. A reverse-engineering derivative, NOT a vendor artifact.

  Sources and citation tags used in descriptions:
    DS     Dahua "HR_C7000 Chip User Guide" v2.7 (English, 734 pp., 2017-07-19); section and PDF
           page are given ("DS §5.4.5.10 p.281"). The Chinese v2.7 original and the v2.2 Chinese
           user manual are cited by name where used.
    FW     the stock DM32.00.01.048 program image (load base 0x03000000; IRAM code at 0x00010000),
           with the instruction or function address. "FW: n reads, m writes" counts come from a
           linear sweep for movih-built peripheral addresses; it cannot see bases kept in RAM
           tables, so "no access found" is not "unused".
    DRV    third-party HR_C7000 driver headers (C7000_DRV.h, bsp_vic.h) from the DemoUV008 source
           tree, used only to corroborate names and offsets the datasheet also gives, except where
           a description says otherwise.
    PSPEC  a third-party processor-spec (.pspec) memory map for the C7000.
    QEMU   the dm32uv-qemu board model (github.com/awkaplan/dm32uv-qemu).
    INFERRED  not stated by any source for this instance; derived by symmetry and marked so.

  Scope: every register is placed at an offset a source gives. Where a register's bit layout is
  not transcribed, it has no <fields> and its description says so. Absence of <registers> means
  "not described here", not "has no registers". Reset values: trust a <resetValue> only where the
  description says where it came from ("Reset 0x... (DS)"); the device-level default below is an
  SVD-schema placeholder.

  Interrupts: <interrupt><value> is the PIC SOURCE number (DS Table 30, p.168-169), the bit index in
  PIC_MASK/PIC_INT_ST (bit n-32 of the *_1 words for n >= 32). The CPU sees source n as VECTOR
  n + 32 (PIC_VECTOR.vector0 resets to 32). Firmware and vendor code pass the vector.

  This file describes memory-mapped I/O only. It is unrelated to the per-unit calibration data
  stored in the radio's external data flash.

  Core: the HR_C7000 CPU is a XuanTie/T-Head CK803S (C-SKY V2), not an ARM Cortex-M. The <cpu>
  block uses SVD's "other" core name only so schema-validating tools accept the file; its
  NVIC/MPU/FPU fields are placeholders. The interrupt controller is the PIC peripheral at
  0x17000000; the stock firmware makes no accesses to the Cortex-M NVIC range at 0xE000E100.
-->
<device schemaVersion="1.3" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <vendor>Dahua Technology (chip); Baofeng (radio product)</vendor>
  <vendorID>DAHUA</vendorID>
  <name>HR_C7000_DM32</name>
  <series>HR_C7000</series>
  <version>0.1-dm32re-draft</version>
  <description>
    Reverse-engineering-derived CMSIS-SVD for the HR_C7000 SoC as used in the Baofeng DM-32UV. NOT
    an official Dahua/Baofeng artifact: assembled from the HR_C7000 v2.7 chip user guide (and the
    v2.2 manual) plus evidence from the stock DM32.00.01.048 firmware and a running radio. CK803S
    (C-SKY V2) core, up to 192 MHz, 320 KB SRAM. Confidence varies per register; see each
    description.
  </description>
  <licenseText>
    License to be decided, as for the rest of the repository this file is published in. The
    underlying HR_C7000 datasheets (Dahua) are marked "Internal disclosure" and are not included.
  </licenseText>
  <cpu>
    <name>other</name>
    <revision>r0p0</revision>
    <endian>little</endian>
    <mpuPresent>false</mpuPresent>
    <fpuPresent>false</fpuPresent>
    <nvicPrioBits>0</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
    <!-- Real core: XuanTie/T-Head CK803S (C-SKY V2 ISA), not represented by any value in this
         enum. Every field in this <cpu> block is a placeholder, not a fact about the DM-32. -->
  </cpu>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>

  <peripherals>

    <!--
      SystemControl and TIMER are HAND-MAINTAINED (everything after them is generated). They cite
      the datasheet the same way, plus firmware evidence. SystemControl keeps names that existing
      decompiler labels use, and is not yet complete against the datasheet: see its description.
    -->
    <peripheral>
      <name>SystemControl</name>
      <description>
        Baseband/modem system control and clock manager, 64 KB window at 0x11000000 (memory
        map, v2.2 manual p.10). Registers from several datasheet chapters share this window:
        soft reset (DS §4.1), clock manager (§4.2), system control and pad mux (§4.4),
        baseband system control (§4.6, Register Table 4 p.144-146), DMR physical layer
        (§9.2, Register Table 27 p.490-492), DMR link layer (§10.2, Register Table 28
        p.526-527) and FM (§11.2). HAND-MAINTAINED and not yet complete: the datasheet also
        lists IOMGR_REN_REG1 (0x44), IOMGR_IE_IE0-2 (0x4c-0x54), RTC_REQ_HOLD (0x58),
        RECV_INFO_COUNT (0x164), RECVFIR_COEF1-17 (0x16c-0x1ac), PHY_RECEIVE_STATE (0x1c0),
        LAYER2_MAX_CNT (0x410), LAYER2_BS_MODE (0x428), BS_SECOND_REG (0x430), BS_STATUS
        (0x434), BS_CACH (0x438), FM_SQL (0x508), USER_DEFINE_CTC (0x51c), CDCSS_ADDR
        (0x520), XTCSS_ADDR (0x52c), FM_FUNCTION_COEF1-8 (0x530-0x54c), FM_DECODE_FLAG1
        (0x564) and FM_ADDR_SW (0x56c), which are not described here (their offsets fall
        inside the RESERVED gaps). Three registers (REG_0x168, REG_0x370-REG_0x37c,
        INTERP_CLEAR_AUX) are not in the datasheet and come from the stock firmware writing
        them; they are named by offset or by placeholder.
      </description>
      <baseAddress>0x11000000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x10000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>

        <register>
          <name>SYS_SOFT_RSTN</name>
          <description>
            Per-module soft reset. DS §4.1.4.1 p.70. Writing 0 to a bit resets that
            module; the bit then returns to 1 by itself (self-clearing pulse, DS
            §4.1.2).
          </description>
          <addressOffset>0x00</addressOffset>
          <resetValue>0x000001FF</resetValue>
          <fields>
            <field><name>cpu_soft_rstn</name><bitOffset>8</bitOffset><bitWidth>1</bitWidth><description>CPU soft reset, low-active, self-clearing</description></field>
            <field><name>sys_soft_rstn</name><bitOffset>7</bitOffset><bitWidth>1</bitWidth><description>System global soft reset, low-active, self-clearing</description></field>
            <field><name>adc_ctrl_soft_rstn</name><bitOffset>6</bitOffset><bitWidth>1</bitWidth><description>Built-in CPU IP ADC soft reset, low-active, self-clearing</description></field>
            <field><name>adc_soft_rstn</name><bitOffset>5</bitOffset><bitWidth>1</bitWidth><description>Built-in baseband IP ADC soft reset, low-active, self-clearing</description></field>
            <field><name>codec_soft_rstn</name><bitOffset>4</bitOffset><bitWidth>1</bitWidth><description>Built-in IP CODEC soft reset, low-active, self-clearing</description></field>
            <field><name>audio_soft_rstn</name><bitOffset>3</bitOffset><bitWidth>1</bitWidth><description>Audio interface module soft reset, low-active, self-clearing</description></field>
            <field><name>fm_soft_rstn</name><bitOffset>2</bitOffset><bitWidth>1</bitWidth><description>FM module soft reset, low-active, self-clearing</description></field>
            <field><name>phy_soft_rstn</name><bitOffset>1</bitOffset><bitWidth>1</bitWidth><description>Physical layer module soft reset, low-active, self-clearing</description></field>
            <field><name>protocol_soft_rstn</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth><description>Protocol layer module soft reset, low-active, self-clearing</description></field>
          </fields>
        </register>

        <register>
          <name>CLK_MGR_REG0x04</name>
          <description>
            Top-level PLL / clock-switch control. DS §4.2.5.1 p.78. The stock boot clock
            init (IRAM 0x12480) busy-waits until bits [31:30] read 1 (dm32uv-qemu
            hw/misc/dm32_sysreg.c models this).
          </description>
          <addressOffset>0x04</addressOffset>
          <fields>
            <field><name>pll_ld</name><bitOffset>31</bitOffset><bitWidth>1</bitWidth><access>read-only</access><description>Combined PLL-A/PLL-B lock flag (RO)</description></field>
            <field><name>clk_rdy</name><bitOffset>30</bitOffset><bitWidth>1</bitWidth><access>read-only</access><description>Clock-switch-ready flag (RO)</description></field>
            <field><name>bclk_work_sel</name><bitOffset>3</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>SOC system clock source select: 0=PLL, 1=oscillator (default: oscillator)</description></field>
            <field><name>aclk_work_sel</name><bitOffset>2</bitOffset><bitWidth>1</bitWidth><description>Baseband/modem system clock source select: 0=PLL, 1=oscillator</description></field>
            <field><name>bclk_re_cfg_reg</name><bitOffset>1</bitOffset><bitWidth>1</bitWidth><description>SOC system PLL reconfiguration-ready flag, set by CPU</description></field>
            <field><name>aclk_re_cfg_reg</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth><description>Baseband/modem PLL reconfiguration-ready flag, set by CPU</description></field>
          </fields>
        </register>

        <register>
          <name>CLK_MGR_REG0x08</name>
          <description>
            APLL configuration. DS §4.2.5.2 p.79. The divider fields below are
            transcribed; the lock, power-down, DSM/DAC power-down and bypass bits in
            [31:24] are not yet transcribed here.
          </description>
          <addressOffset>0x08</addressOffset>
          <fields>
            <field><name>refdiv</name><bitOffset>18</bitOffset><bitWidth>6</bitWidth><description>APLL reference divider (default 0x1)</description></field>
            <field><name>fbdiv</name><bitOffset>6</bitOffset><bitWidth>12</bitWidth><description>APLL feedback divider (default 0x3a = 58)</description></field>
            <field><name>postdiv1</name><bitOffset>3</bitOffset><bitWidth>3</bitWidth><description>APLL post-divider 1 (default 0x6)</description></field>
            <field><name>postdiv2</name><bitOffset>0</bitOffset><bitWidth>3</bitWidth><description>APLL post-divider 2 (default 0x2)</description></field>
          </fields>
        </register>

        <register>
          <name>CLK_MGR_REG0x0c</name>
          <description>
            APLL fractional divider (apll_frac). DS §4.2.5.3 p.81.
          </description>
          <addressOffset>0x0c</addressOffset>
          <resetValue>0x00FB7E91</resetValue>
          <fields>
            <field><name>apll_frac</name><bitOffset>0</bitOffset><bitWidth>24</bitWidth><description>APLL fractional-mode divider value</description></field>
          </fields>
        </register>

        <register>
          <name>CLK_MGR_REG0x10</name>
          <description>
            BPLL configuration, same layout as CLK_MGR_REG0x08. DS §4.2.5.4 p.81. Upper
            control bits not yet transcribed here.
          </description>
          <addressOffset>0x10</addressOffset>
          <fields>
            <field><name>refdiv</name><bitOffset>18</bitOffset><bitWidth>6</bitWidth><description>BPLL reference divider (default 0x2)</description></field>
            <field><name>fbdiv</name><bitOffset>6</bitOffset><bitWidth>12</bitWidth><description>BPLL feedback divider (default 0x28 = 40)</description></field>
            <field><name>postdiv1</name><bitOffset>3</bitOffset><bitWidth>3</bitWidth><description>BPLL post-divider 1 (default 0x2)</description></field>
            <field><name>postdiv2</name><bitOffset>0</bitOffset><bitWidth>3</bitWidth><description>BPLL post-divider 2 (default 0x2)</description></field>
          </fields>
        </register>

        <register>
          <name>CLK_MGR_REG0x14</name>
          <description>
            BPLL fractional divider (bpll_frac). DS §4.2.5.5 p.82.
          </description>
          <addressOffset>0x14</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field><name>bpll_frac</name><bitOffset>0</bitOffset><bitWidth>24</bitWidth><description>BPLL fractional-mode divider value</description></field>
          </fields>
        </register>

        <register>
          <name>CLK_MGR_REG0x18</name>
          <description>
            Per-domain output clock divider numerators. DS §4.2.5.6 p.83.
          </description>
          <addressOffset>0x18</addressOffset>
          <fields>
            <field><name>dac_clk_div_num</name><bitOffset>24</bitOffset><bitWidth>8</bitWidth><description>DAC clock divider numerator (default 0x10)</description></field>
            <field><name>bclk_out_div_num</name><bitOffset>16</bitOffset><bitWidth>8</bitWidth><description>SOC output clock divider numerator (default 0xa)</description></field>
            <field><name>aclk_out_div_num</name><bitOffset>8</bitOffset><bitWidth>8</bitWidth><description>Baseband/modem output clock divider numerator (default 0xc)</description></field>
            <field><name>modem_clk_div_num</name><bitOffset>0</bitOffset><bitWidth>8</bitWidth><description>Modem clock divider numerator (default 0xc)</description></field>
          </fields>
        </register>

        <register>
          <name>CLK_MGR_REG0x1c</name>
          <description>
            Fractional dividers for the 32 kHz and 192 kHz clocks (denominator/numerator
            pairs). DS §4.2.5.7 p.83. Bit ranges not yet transcribed here; no fields
            defined.
          </description>
          <addressOffset>0x1c</addressOffset>
        </register>

        <register>
          <name>CLK_MGR_REG0x20</name>
          <description>
            Codec MCLK source select (mclk_sel_reg) and divider (mclk_div_num: 24 MHz /
            (mclk_div_num + 1)), plus the 8 kHz and 512 kHz fractional dividers. DS
            §4.2.5.8 p.83. Bit ranges not yet transcribed here.
          </description>
          <addressOffset>0x20</addressOffset>
        </register>

        <register>
          <name>CLK_MGR_REG0x24</name>
          <description>
            CPU-side DAC/ADC clock dividers, SDIO clock delay tuning
            (sdio_clk_dly_reg_drv/_sample), AHB:APB ratio (apb_clk_div_num: 0 = 1:1, 1 =
            1:2, 2 = 1:4) and AHB:CPU ratio (cpu_clk_ratio_reg: 0 = 1:1, 1 = 1:2). DS
            §4.2.5.9 p.84. Bit positions not yet transcribed here.
          </description>
          <addressOffset>0x24</addressOffset>
        </register>

        <register>
          <name>CLK_MGR_REG0x28</name>
          <description>
            SDIO clock divider (from a doubled 96 MHz clock) and USB 48 MHz divider. DS
            §4.2.5.10 p.85. Bit ranges not yet transcribed here.
          </description>
          <addressOffset>0x28</addressOffset>
        </register>

        <register>
          <name>CLK_MGR_REG0x2c</name>
          <description>
            Clock-gate enables. DS §4.2.5.11 p.86. Field names: dac_clk_en, adc_clk_en,
            hclk_en, pclk_en, sdio_hclk_en, sdio_clk_en, usb_hclk_en, usb_clk_en,
            mc_clk_en, modem_clk_rx_en, modem_clk_tx_en, modem_clk_fmrx_en,
            modem_clk_fmtx_en, clk_512k_en_reg, clk_8k_en_reg, bclk_out_en_reg,
            aclk_out_en_reg. Bit positions not yet transcribed here.
          </description>
          <addressOffset>0x2c</addressOffset>
        </register>

        <register>
          <name>LCSFC_BAUDR</name>
          <description>
            Program-flash controller (LCSFC) SPI SCLK divider, lcsfc_baudr [31:0], reset
            0x4. DS §4.4.4.1 p.93.
          </description>
          <addressOffset>0x30</addressOffset>
        </register>

        <register>
          <name>IO_DIPLEX0</name>
          <description>
            Pad multiplexing, bank 0: JTAG, I2C0/1, UART1-3, PWM0-2 and PTB7 (AK codec
            ADC_SDO) pads. DS §4.4.4.4 p.93. General rule (DS §4.4.4.4-4.4.4.6): each
            field's all-ones value selects the pad's GPIO function (GPIO_PTxN = bank x,
            bit N) and each field resets to it, except the five JTAG selects [4:0],
            which reset to 0 = JTAG; setting them loses the JTAG port. A pad must be
            switched away from GPIO before its peripheral sees it.
          </description>
          <addressOffset>0x34</addressOffset>
          <resetValue>0x800FFFE0</resetValue>
          <fields>
            <field><name>ptb7_sel</name><bitOffset>31</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>PTB7 multiplexing selection. 1: GPIO1_PTB7; 0: AK_ADC_SDO. (GPIO1_PTB7 = GPIOB bit 7.) [reset 0x1]</description></field>
            <field><name>pwm2_sel</name><bitOffset>19</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>PWM_2 multiplexing selection. 1: GPIO_PTA17; 0: PWM_2 [reset 0x1]</description></field>
            <field><name>pwm1_sel</name><bitOffset>18</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>PWM_1 multiplexing selection. 1: GPIO_PTA16; 0: PWM_1 [reset 0x1]</description></field>
            <field><name>pwm0_sel</name><bitOffset>17</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>PWM_0 multiplexing selection. 1: GPIO_PTA15; 0: PWM_0 [reset 0x1]</description></field>
            <field><name>uart3_txd_sel</name><bitOffset>15</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>UART3_TXD multiplexing selection. 3: GPIO_PTA14; 2: Reserved; 1: Baseband rf_rx_inter; 0: UART3_TXD [reset 0x3]</description></field>
            <field><name>uart3_rxd_sel</name><bitOffset>13</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>UART3_RXD multiplexing selection. 3: GPIO_PTA13; 2: Reserved; 1: Baseband rf_tx_inter; 0: UART3_RXD [reset 0x3]</description></field>
            <field><name>uart2_txd_sel</name><bitOffset>12</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>UART2_TXD multiplexing selection. 1: GPIO_PTA12; 0: UART2_TXD [reset 0x1]</description></field>
            <field><name>uart2_rxd_sel</name><bitOffset>11</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>UART2_RXD multiplexing selection. 1: GPIO_PTA11; 0: UART2_RXD [reset 0x1]</description></field>
            <field><name>uart1_txd_sel</name><bitOffset>10</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>UART1_TXD multiplexing selection. 1: GPIO_PTA10; 0: UART1_TXD [reset 0x1]</description></field>
            <field><name>uart1_rxd_sel</name><bitOffset>9</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>UART1_RXD multiplexing selection. 1: GPIO_PTA9; 0: UART1_RXD [reset 0x1]</description></field>
            <field><name>i2c1_sda_sel</name><bitOffset>8</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>I2C_SDA_1 multiplexing selection. 1: GPIO_PTA8; 0: I2C_SDA_1 [reset 0x1]</description></field>
            <field><name>i2c1_scl_sel</name><bitOffset>7</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>I2C_SCL_1 multiplexing selection. 1: GPIO_PTA7; 0: I2C_SCL_1 [reset 0x1]</description></field>
            <field><name>i2c0_sda_sel</name><bitOffset>6</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>I2C_SDA_0 multiplexing selection. 1: GPIO_PTA6; 0: I2C_SDA_0 [reset 0x1]</description></field>
            <field><name>i2c0_scl_sel</name><bitOffset>5</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>I2C_SCL_0 multiplexing selection. 1: GPIO_PTA5; 0: I2C_SCL_0 [reset 0x1]</description></field>
            <field><name>jtg_rstn_sel</name><bitOffset>4</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>JTG_RST_N multiplexing selection. 1: GPIO_PTA4; 0: JTG_RST_N [reset 0x0]</description></field>
            <field><name>jtg_tdo_sel</name><bitOffset>3</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>JTG_TDO multiplexing selection. 1: GPIO_PTA3; 0: JTG_TDO [reset 0x0]</description></field>
            <field><name>jtg_tdi_sel</name><bitOffset>2</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>JTG_TDI multiplexing selection. 1: GPIO_PTA2; 0: JTG_TDI [reset 0x0]</description></field>
            <field><name>jtg_tck_sel</name><bitOffset>1</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>JTG_TCK multiplexing selection. 1: GPIO_PTA1; 0: JTG_TCK [reset 0x0]</description></field>
            <field><name>jtg_tms_sel</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>JTG_TMS multiplexing selection. 1: GPIO_PTA0; 0: JTG_TMS [reset 0x0]</description></field>
          </fields>
        </register>

        <register>
          <name>IO_DIPLEX1</name>
          <description>
            Pad multiplexing, bank 1: SPI0/SPI1 (with SDIO alternates), the baseband
            TIME_SLOT/BS_INTER lines and PTB2-PTB6 (AK codec ADC/DAC serial pads). DS
            §4.4.4.5 p.97. FW: hr_c7000_modem_core_clock_and_reset_init @0x0301d5f8 sets
            bits 27-29 (|= 0x38000000: PTB2-PTB4 to GPIO).
          </description>
          <addressOffset>0x38</addressOffset>
          <resetValue>0xFFFFFFFF</resetValue>
          <fields>
            <field><name>ptb6_sel</name><bitOffset>31</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>PTB6 multiplexing selection. 1: GPIO1_PTB6; 0: AK_ADC_SCLK [reset 0x1]</description></field>
            <field><name>ptb5_sel</name><bitOffset>30</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>PTB4 multiplexing selection. 1: GPIO1_PTB5; 0: AK_ADC_FS. The guide prints this row's name as 'PTB4', a typo for PTB5 (the GPIO it selects is PTB5). [reset 0x1]</description></field>
            <field><name>ptb4_sel</name><bitOffset>29</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>PTB4 multiplexing selection. 1: GPIO1_PTB4; 0: AK_DAC_SDI [reset 0x1]</description></field>
            <field><name>ptb3_sel</name><bitOffset>28</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>PTB3 multiplexing selection. 1: GPIO1_PTB3; 0: AK_DAC_SCLK [reset 0x1]</description></field>
            <field><name>ptb2_sel</name><bitOffset>27</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>PTB2 multiplexing selection. 1: GPIO1_PTB2; 0: AK_DAC_FS [reset 0x1]</description></field>
            <field><name>time_slot_tx_sel</name><bitOffset>25</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>TIME_SLOT_T_INTER multiplexing selection. 3: GPIO_PTA31; 2: SDIO sdio_card_write_prt; 1: Reserved; 0: TIME_SLOT_T_INTER [reset 0x3]</description></field>
            <field><name>time_slot_rx_sel</name><bitOffset>23</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>TIME_SLOT_R_INTER multiplexing selection. 3: GPIO_PTA30; 2: SDIO sdio_card_detect_n; 1: Reserved; 0: TIME_SLOT_R_INTER [reset 0x3]</description></field>
            <field><name>bs_inter_out_sel</name><bitOffset>21</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>BS_INTER_OUT multiplexing selection. 3: GPIO_PTA29; 2: SDIO sdio_cdata[1]; 1: Reserved; 0: BS_INTER_OUT [reset 0x3]</description></field>
            <field><name>bs_inter_in_sel</name><bitOffset>19</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>BS_INTER_IN multiplexing selection. 3: GPIO_PTA28; 2: SDIO sdio_cdata[2]; 1: POR_RST_N; 0: BS_INTER_IN [reset 0x3]</description></field>
            <field><name>spi1_miso_sel</name><bitOffset>17</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>SPI1_MISO multiplexing selection. 3: GPIO_PTA27; 2: SDIO sdio_cdata[0]; 1: Slave SPI1_MISO; 0: Master SPI1_MISO [reset 0x3]</description></field>
            <field><name>spi1_mosi_sel</name><bitOffset>15</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>SPI1_MOSI multiplexing selection. 3: GPIO_PTA26; 2: SDIO sdio_ccmd; 1: Slave SPI1_MOSI; 0: Master SPI1_MOSI [reset 0x3]</description></field>
            <field><name>spi1_sclk_sel</name><bitOffset>13</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>SPI1_SCLK multiplexing selection. 3: GPIO_PTA25; 2: SDIO sdio_cclk_out; 1: Slave SPI1_SCLK; 0: Master SPI1_SCLK [reset 0x3]</description></field>
            <field><name>spi1_csn1_sel</name><bitOffset>11</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>SPI1_CSN_1 multiplexing selection. 3: GPIO_PTA24; 2: Reserved; 1: Baseband sys_inter; 0: Master SPI1_CSN_1 [reset 0x3]</description></field>
            <field><name>spi1_csn0_sel</name><bitOffset>9</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>SPI1_CSN_0 multiplexing selection. 3: GPIO_PTA23; 2: SDIO sdio_cdata[3]; 1: Slave SPI1_CSN_0; 0: Master SPI1_CSN_0 [reset 0x3]</description></field>
            <field><name>spi0_miso_sel</name><bitOffset>7</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>SPI0_MISO multiplexing selection. 3: GPIO_PTA22; 2: Reserved; 1: Slave SPI0_MISO; 0: Master SPI0_MISO [reset 0x3]</description></field>
            <field><name>spi0_mosi_sel</name><bitOffset>5</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>SPI0_MOSI multiplexing selection. 3: GPIO_PTA21; 2: Reserved; 1: Slave SPI0_MOSI; 0: Master SPI0_MOSI [reset 0x3]</description></field>
            <field><name>spi0_sclk_sel</name><bitOffset>3</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>SPI0_SCLK multiplexing selection. 3: GPIO_PTA20; 2: Reserved; 1: Slave SPI0_SCLK; 0: Master SPI0_SCLK [reset 0x3]</description></field>
            <field><name>spi0_csn1_sel</name><bitOffset>2</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>SPI0_CSN_1 multiplexing selection. 1: GPIO_PTA19; 0: SPI0_CSN_1 [reset 0x1]</description></field>
            <field><name>spi0_csn0_sel</name><bitOffset>0</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>SPI0_CSN_0 multiplexing selection. 3: GPIO_PTA18; 2: Reserved; 1: Slave SPI0_CSN_0; 0: Master SPI0_CSN_0 [reset 0x3]</description></field>
          </fields>
        </register>

        <register>
          <name>IO_DIPLEX2</name>
          <description>
            Pad multiplexing, bank 2: CLK_OUT, the LCD bus (CS/RS/WR/RD, DB0-DB7;
            CS/RS/DB0/DB1 also SPI2), ADC0-7 inputs and DAC_VOUT_MCUA-C. DS §4.4.4.6
            p.101. FW: every stock keypad scan (keypad_scan_and_map_pressed_key
            @0x03013660) first calls 0x03012e14, which sets IO_DIPLEX2 |= 0xfe00
            (LCD_DB0-DB4 pads = GPIOC 7-11 to GPIO, to drive the keypad lines);
            lcd_bus_restore_after_keypad_scan @0x0301cad0 undoes it with &amp;=
            0xffff01ff, and the panel init lcd_controller_power_on_init_sequence
            @0x03017d4c claims the panel pads with &amp;= 0xfff80107 (literal at
            0x03017f4c). An LCD write while DB0-DB4 are muxed to GPIO misses the panel
            (observed on hardware: the panel stays white until power-cycled).
          </description>
          <addressOffset>0x3c</addressOffset>
          <resetValue>0x3FFFFFFB</resetValue>
          <fields>
            <field><name>dac_vout_mcuc_sel</name><bitOffset>29</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>DAC_VOUT_MCUC multiplexing selection. 1: GPIO_PTC25; 0: DAC_VOUT_MCUC [reset 0x1]</description></field>
            <field><name>dac_vout_mcub_sel</name><bitOffset>28</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>DAC_VOUT_MCUB multiplexing selection. 1: GPIO_PTC24; 0: DAC_VOUT_MCUB [reset 0x1]</description></field>
            <field><name>dac_vout_mcua_sel</name><bitOffset>27</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>DAC_VOUT_MCUA multiplexing selection. 1: GPIO_PTC23; 0: DAC_VOUT_MCUA [reset 0x1]</description></field>
            <field><name>adc7_in_sel</name><bitOffset>26</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>ADC7_IN multiplexing selection. 1: GPIO_PTC22; 0: ADC7_IN [reset 0x1]</description></field>
            <field><name>adc6_in_sel</name><bitOffset>25</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>ADC6_IN multiplexing selection. 1: GPIO_PTC21; 0: ADC6_IN [reset 0x1]</description></field>
            <field><name>adc5_in_sel</name><bitOffset>24</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>ADC5_IN multiplexing selection. 1: GPIO_PTC20; 0: ADC5_IN [reset 0x1]</description></field>
            <field><name>adc4_in_sel</name><bitOffset>23</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>ADC4_IN multiplexing selection. 1: GPIO_PTC19; 0: ADC4_IN [reset 0x1]</description></field>
            <field><name>adc3_in_sel</name><bitOffset>22</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>ADC3_IN multiplexing selection. 1: GPIO_PTC18; 0: ADC3_IN [reset 0x1]</description></field>
            <field><name>adc2_in_sel</name><bitOffset>21</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>ADC2_IN multiplexing selection. 1: GPIO_PTC17; 0: ADC2_IN [reset 0x1]</description></field>
            <field><name>adc1_in_sel</name><bitOffset>20</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>ADC1_IN multiplexing selection. 1: GPIO_PTC16; 0: ADC1_IN [reset 0x1]</description></field>
            <field><name>adc0_in_sel</name><bitOffset>19</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>ADC0_IN multiplexing selection. 1: GPIO_PTC15; 0: ADC0_IN [reset 0x1]</description></field>
            <field><name>lcd_db7_sel</name><bitOffset>18</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>LCD_DB7 multiplexing selection. 1: GPIO_PTC24; 0: LCD_DB7. The guide prints GPIO_PTC24, which bit 28 also claims; the pattern of the neighbouring rows gives GPIO_PTC14 (INFERRED). [reset 0x1]</description></field>
            <field><name>lcd_db6_sel</name><bitOffset>17</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>LCD_DB6 multiplexing selection. 1: GPIO_PTC13; 0: LCD_DB6 [reset 0x1]</description></field>
            <field><name>lcd_db5_sel</name><bitOffset>16</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>LCD_DB5 multiplexing selection. 1: GPIO_PTC12; 0: LCD_DB5 [reset 0x1]</description></field>
            <field><name>lcd_db4_sel</name><bitOffset>15</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>LCD_DB4 multiplexing selection. 1: GPIO_PTC11; 0: LCD_DB4 [reset 0x1]</description></field>
            <field><name>lcd_db3_sel</name><bitOffset>14</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>LCD_DB3 multiplexing selection. 1: GPIO_PTC10; 0: LCD_DB3 [reset 0x1]</description></field>
            <field><name>lcd_db2_sel</name><bitOffset>13</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>LCD_DB2 multiplexing selection. 1: GPIO_PTC9; 0: LCD_DB2 [reset 0x1]</description></field>
            <field><name>lcd_db1_sel</name><bitOffset>11</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>LCD_DB1 multiplexing selection. 3: GPIO_PTC8; 2: Slave SPI2_MOSI; 1: Master SPI2_MOSI; 0: LCD_DB1 [reset 0x3]</description></field>
            <field><name>lcd_db0_sel</name><bitOffset>9</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>LCD_DB0 multiplexing selection. 3: GPIO_PTC7; 2: Slave SPI2_MISO; 1: Master SPI2_MISO; 0: LCD_DB0 [reset 0x3]</description></field>
            <field><name>lcd_rd_sel</name><bitOffset>8</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>LCD_RD multiplexing selection. 1: GPIO_PTC6; 0: LCD_RD [reset 0x1]</description></field>
            <field><name>lcd_wr_sel</name><bitOffset>7</bitOffset><bitWidth>1</bitWidth><access>read-write</access><description>LCD_WR multiplexing selection. 1: GPIO_PTC5; 0: LCD_WR [reset 0x1]</description></field>
            <field><name>lcd_rs_sel</name><bitOffset>5</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>LCD_RS multiplexing selection. 3: GPIO_PTC4; 2: Slave SPI2_SCLK; 1: Master SPI2_SCLK; 0: LCD_RS [reset 0x3]</description></field>
            <field><name>lcd_cs_sel</name><bitOffset>3</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>LCD_CS multiplexing selection. 3: GPIO_PTC3; 2: Slave SPI2_CS; 1: Master SPI2_CS; 0: LCD_CS [reset 0x3]</description></field>
            <field><name>clk_out_sel</name><bitOffset>0</bitOffset><bitWidth>2</bitWidth><access>read-write</access><description>CLK_OUT multiplexing selection. 3: GPIO_PTC0; 2: RTC_CLK; 1: PLLB CLK_OUT; 0: PLLA CLK_OUT [reset 0x3]</description></field>
          </fields>
        </register>

        <register>
          <name>RESERVED_0x40</name>
          <description>
            The datasheet's IOMGR_REN_REG0 (pad pull-up enables, 1 = pull-up off, 0 =
            on; DS §4.4.4.7 p.105), kept under this placeholder name so existing
            decompiler labels stay stable; fields not transcribed here. FW:
            hr_c7000_modem_core_clock_and_reset_init @0x0301d5f8 clears bit 24
            (spi1_csn1_ren: pull-up on) and sets bit 25 (spi1_sclk_ren: off) right after
            its IO_DIPLEX1 write.
          </description>
          <addressOffset>0x40</addressOffset>
        </register>

        <register>
          <name>RESERVED_0x48</name>
          <description>
            The datasheet's IOMGR_REN_REG2 (pad pull-up enables for PTB pads, 1 =
            pull-up off; DS §4.4.4.9 p.113), kept under this placeholder name; fields
            not transcribed here. FW: the same function as RESERVED_0x40 sets bits 27
            and 26 (ptb27_ren, ptb26_ren: pull-ups off).
          </description>
          <addressOffset>0x48</addressOffset>
        </register>

        <register>
          <name>QUAD_ENABLE</name>
          <description>
            Program-flash controller quad mode: quad_enable [0] (four-wire enable, high
            active) and sys_sample_delay [31:24] (input sampling delay, 0-8). DS
            §4.4.4.3 p.93. Fields not transcribed here.
          </description>
          <addressOffset>0x5c</addressOffset>
        </register>

        <register>
          <name>DAC_CONTROL</name>
          <description>
            Baseband DAC control (power-down, low-power mode, data format). DS §4.6.5.1
            p.146. Fields not transcribed here.
          </description>
          <addressOffset>0x70</addressOffset>
        </register>

        <register>
          <name>ADC_CONTROL</name>
          <description>
            Baseband ADC control. DS §4.6.5.2 p.146. Fields not transcribed here.
          </description>
          <addressOffset>0x74</addressOffset>
        </register>

        <register>
          <name>AUDIO_CONTROL</name>
          <description>
            Audio path routing. DS §4.6.5.3 p.148. The stock firmware's bit-mask writes
            match these field names.
          </description>
          <addressOffset>0x80</addressOffset>
          <resetValue>0x00000002</resetValue>
          <fields>
            <field><name>ring_full_two</name><bitOffset>31</bitOffset><bitWidth>1</bitWidth><access>read-only</access><description>Prompt-tone PCM FIFO full flag (RO); stop writing until it clears</description></field>
            <field><name>ring_play_ctrl</name><bitOffset>7</bitOffset><bitWidth>1</bitWidth><description>Select prompt/alert-tone path, high-active</description></field>
            <field><name>fm_play_ctrl</name><bitOffset>6</bitOffset><bitWidth>1</bitWidth><description>Select FM playback channel, high-active</description></field>
            <field><name>ahb_rd_voice_en</name><bitOffset>5</bitOffset><bitWidth>1</bitWidth><description>AHB read-audio enable, high-active</description></field>
            <field><name>ahb_wr_voice_en</name><bitOffset>4</bitOffset><bitWidth>1</bitWidth><description>AHB write-audio start flag, high-active</description></field>
            <field><name>fm_sidetone_en</name><bitOffset>3</bitOffset><bitWidth>1</bitWidth><description>Analog sidetone playback enable, high-active</description></field>
            <field><name>sel_i2s</name><bitOffset>2</bitOffset><bitWidth>1</bitWidth><description>I2S interface enable (baseband test mode)</description></field>
            <field><name>i2s_slave_mode</name><bitOffset>1</bitOffset><bitWidth>1</bitWidth><description>Audio I2S master/slave: 0=master, 1=slave (baseband test mode). Default 1.</description></field>
            <field><name>tx_voice_source</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth><description>Voice-frame source select: 0=Codec/vocoder (normal handheld use), 1=MCU RAM (Layer-2 BS send mode)</description></field>
          </fields>
        </register>

        <register>
          <name>AUDIO_BUFFER_CLR</name>
          <description>
            Vocoder encode/decode buffer clear. DS §4.6.5.4 p.150. Both bits are
            write-1-to-clear and release themselves.
          </description>
          <addressOffset>0x84</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field><name>clr_rd_ram_cpu</name><bitOffset>1</bitOffset><bitWidth>1</bitWidth><description>Write 1 to clear the vocoder DECODE buffer; self-clears</description></field>
            <field><name>clr_wr_ram_cpu</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth><description>Write 1 to clear the vocoder ENCODE buffer; self-clears</description></field>
          </fields>
        </register>

        <register>
          <name>LINEOUT_CTRL</name>
          <description>
            Codec line-out enables. DS §4.6.5.5 p.150.
          </description>
          <addressOffset>0x88</addressOffset>
          <fields>
            <field><name>standby_lo</name><bitOffset>31</bitOffset><bitWidth>1</bitWidth><access>read-only</access><description>Line-out standby status (RO)</description></field>
            <field><name>line1out_en</name><bitOffset>1</bitOffset><bitWidth>1</bitWidth><description>Line-out 1 enable</description></field>
            <field><name>line2out_en</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth><description>Line-out 2 enable</description></field>
          </fields>
        </register>

        <register>
          <name>CODEC_I2C_MUX</name>
          <description>
            Codec control-interface select. DS §4.6.5.6 p.150.
          </description>
          <addressOffset>0x8c</addressOffset>
          <fields>
            <field><name>codec_si2c_reg</name><bitOffset>7</bitOffset><bitWidth>1</bitWidth><description>Codec control interface select: 0=MC interface, 1=I2C</description></field>
            <field><name>codec_i2c_address_reg</name><bitOffset>0</bitOffset><bitWidth>7</bitWidth><description>Codec I2C address (when codec_si2c_reg=1)</description></field>
          </fields>
        </register>

        <register>
          <name>WORK_MODE</name>
          <description>
            Baseband working mode: digital/analog, Tier I/II, continuous/timeslot, layer
            mode [4:3] (0 physical, 1 layer 2, 2 layer 3), repeater, alignment, working
            slot. DS §4.6.5.7 p.151, §9.2.2.1 p.492 (the DMR and FM chapters repeat it).
            Fields not transcribed here. An emulator trace (dm32uv-qemu
            hw/misc/dm32_sysreg.c) saw (value &amp; 0x18) != 0, i.e. a non-physical
            layer mode, when the modem entered active free-run establishment in a
            TX-slot self-test.
          </description>
          <addressOffset>0x100</addressOffset>
        </register>

        <register>
          <name>RF_MODE</name>
          <description>
            Baseband RF interface mode. DS §4.6.5.8 p.152, §9.2.2.2 p.494. Fields not
            transcribed here.
          </description>
          <addressOffset>0x104</addressOffset>
        </register>

        <register>
          <name>SIG_CENTER</name>
          <description>
            TX/RX IQ DC-bias setting. FW: mmio_11000108_high_word_write_from_byte
            @0x0302180c writes a repeated byte into the upper 16 bits (param &lt;&lt; 24
            | (param &amp; 0xff) &lt;&lt; 16). DS §9.2.2.3 p.496.
          </description>
          <addressOffset>0x108</addressOffset>
        </register>

        <register>
          <name>TX_IF_FREQ</name>
          <description>
            TX IF frequency word. FW: hr_c7000_modem_core_register_init @0x03023608. DS
            §9.2.2.4 p.497.
          </description>
          <addressOffset>0x10c</addressOffset>
        </register>

        <register>
          <name>RF_CONTROL</name>
          <description>
            RF TX/RX interrupt advance. FW: modem_rf_mode_transition_apply @0x0301e628
            ORs in 0x1a00 then 0x12, next to an RF_MODE |= 0x800 write, in one RF-mode
            branch. DS §9.2.2.5 p.498.
          </description>
          <addressOffset>0x110</addressOffset>
        </register>

        <register>
          <name>RF_MOD_BIAS_CTRL</name>
          <description>
            TX signal amplitude adjustment. FW: mmio_11000114_low_word_duplicate_write
            @0x03021830 writes (param &amp; 0xff) * 0x101 into the low 16 bits. DS
            §9.2.2.6 p.498.
          </description>
          <addressOffset>0x114</addressOffset>
        </register>

        <register>
          <name>DEV_LIMITER</name>
          <description>
            TX frequency-deviation threshold. FW: hr_c7000_modem_core_register_init
            @0x03023608, FUN_00016b60. DS §9.2.2.7 p.498.
          </description>
          <addressOffset>0x118</addressOffset>
        </register>

        <register>
          <name>RSSI_BIAS_VALUE</name>
          <description>
            Signal-energy detection value and ADC DC-bias detection. FW:
            hr_c7000_modem_core_register_init @0x03023608, FUN_030c6780. DS §9.2.2.8
            p.498.
          </description>
          <addressOffset>0x11c</addressOffset>
        </register>

        <register>
          <name>THRESHOLD_VALUE</name>
          <description>
            Sync-detection threshold. FW: hr_c7000_modem_core_register_init @0x03023608.
            DS §9.2.2.9 p.499.
          </description>
          <addressOffset>0x120</addressOffset>
        </register>

        <register>
          <name>PHASE_OUT</name>
          <description>
            Phase-input amplitude detection in AF receive mode. DS §9.2.2.10 p.500.
          </description>
          <addressOffset>0x128</addressOffset>
        </register>

        <register>
          <name>SEND_DATA_SYNC_H</name>
          <description>
            TX data sync pattern, high half. FW: modem_rf_mode_transition_apply
            @0x0301e628 loads SEND_DATA_SYNC_H/L as a pair from one of two 2-word tables
            (literal-pool slots 0x0301e890 and 0x0301e738), depending on the mode. DS
            §9.2.2.11 p.500.
          </description>
          <addressOffset>0x12c</addressOffset>
        </register>

        <register>
          <name>SEND_DATA_SYNC_L</name>
          <description>
            TX data sync pattern, low half (see SEND_DATA_SYNC_H). DS §9.2.2.12 p.500.
          </description>
          <addressOffset>0x130</addressOffset>
        </register>

        <register>
          <name>SEND_RC_SYNC_H</name>
          <description>
            TX RC (reverse channel) sync pattern, high half. DS §9.2.2.13 p.502.
          </description>
          <addressOffset>0x134</addressOffset>
        </register>

        <register>
          <name>SEND_RC_SYNC_L</name>
          <description>
            TX RC sync pattern, low half. DS §9.2.2.14 p.502.
          </description>
          <addressOffset>0x138</addressOffset>
        </register>

        <register>
          <name>RECV_MS_SYNC_H</name>
          <description>
            RX MS data sync pattern, high half. DS §9.2.2.15 p.502.
          </description>
          <addressOffset>0x13c</addressOffset>
        </register>

        <register>
          <name>RECV_MS_SYNC_L</name>
          <description>
            RX MS data sync pattern, low half. DS §9.2.2.16 p.502.
          </description>
          <addressOffset>0x140</addressOffset>
        </register>

        <register>
          <name>RECV_BS_SYNC_H</name>
          <description>
            RX BS data sync pattern, high half. DS §9.2.2.17 p.503.
          </description>
          <addressOffset>0x144</addressOffset>
        </register>

        <register>
          <name>RECV_BS_SYNC_L</name>
          <description>
            RX BS data sync pattern, low half. DS §9.2.2.18 p.504.
          </description>
          <addressOffset>0x148</addressOffset>
        </register>

        <register>
          <name>RECV_TDMA1_SYNC_H</name>
          <description>
            RX TDMA1 data sync pattern, high half. DS §9.2.2.19 p.504.
          </description>
          <addressOffset>0x14c</addressOffset>
        </register>

        <register>
          <name>RECV_TDMA1_SYNC_L</name>
          <description>
            RX TDMA1 data sync pattern, low half. DS §9.2.2.20 p.504.
          </description>
          <addressOffset>0x150</addressOffset>
        </register>

        <register>
          <name>RECV_TDMA2_SYNC_H</name>
          <description>
            RX TDMA2 data sync pattern, high half. DS §9.2.2.21 p.505.
          </description>
          <addressOffset>0x154</addressOffset>
        </register>

        <register>
          <name>RECV_TDMA2_SYNC_L</name>
          <description>
            RX TDMA2 data sync pattern, low half. DS §9.2.2.22 p.506.
          </description>
          <addressOffset>0x158</addressOffset>
        </register>

        <register>
          <name>RECV_RC_SYNC_H</name>
          <description>
            RX RC data sync pattern, high half. DS §9.2.2.23 p.506.
          </description>
          <addressOffset>0x15c</addressOffset>
        </register>

        <register>
          <name>RECV_RC_SYNC_L</name>
          <description>
            RX RC data sync pattern, low half. DS §9.2.2.24 p.506.
          </description>
          <addressOffset>0x160</addressOffset>
        </register>

        <register>
          <name>REG_0x168</name>
          <description>
            Not in the datasheet: Register Table 27 (DS §9.2.1 p.490-492) goes from
            RECV_INFO_COUNT (0x164) to RECVFIR_COEF1 (0x16c), and no edition lists
            0x168. Its existence comes from the stock firmware, which writes it:
            hr_c7000_modem_core_register_init @0x03023608 stores 0x14 (0x03023760) when
            the RF mode is 4 and 0x98 (0x030237ba) otherwise, and
            radio_mode_transition_sequencer @0x03021670 stores 0x98 (0x0302172c); each
            store is paired with an RF_RECV_DELAY write (14000 or 0). A third-party
