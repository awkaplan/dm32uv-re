          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>USB</name>
      <description>Synopsys DesignWare USB 2.0 OTG controller (GSNPSID reads 0x4f54270a), configured device-only with a USB 1.1 full-speed serial transceiver (GUSBCFG.PHYSel=1) (DS §5.6, p.325-377; Register Table 19 is mistitled 'SDIO Register Overview'). IN endpoints 0/1/3 and OUT endpoints 0/2/4 are implemented. FW: no direct access; one base literal at 0x0301f178. The DM-32's USB-C port is not known to carry data.</description>
      <groupName>USB</groupName>
      <baseAddress>0x13000000</baseAddress>
      <addressBlock><offset>0x0</offset><size>0x40000</size><usage>registers</usage></addressBlock>
      <interrupt><name>USB</name><description>PIC source 21 (bit 21 of PIC_MASK/INT_ST), default CPU vector 53 (DS Table 30, p.168-169)</description><value>21</value></interrupt>
      <registers>
        <register>
          <name>GAHBCFG</name>
          <description>AHB Configuration , global AHB Configuration. DS §5.6.5.1 p.336. Reset 0x0 (DS).</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>NPTxFEmpLvl</name>
              <description>Non-Periodic TxFIFO Empty Level , dedicated FIFO In dev mode , 0 : DIENPINTn.TxFEmp indicates that the IN EP TxFIFO is half full. 1 : DIENPINTn.TxFEmp , indicates IN EP TxFIFO is full [reset 0x0] [access RW]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DMAEn</name>
              <description>DMA Enable 0 : Slave mode; 1 : DMA mode [reset 0x0] [access RW]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>HBstLen</name>
              <description>Burst Length/Type , configure dma_burst[3:0] in DMA mode When internal DMA is configured 4'h0: Single 4'h1: INCR 4'h3: INCR4 4'h5: INCR8 4'h7: INCR16 Other : Reserved [reset 0x0] [access RW]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>GlbIntrMsk</name>
              <description>Global Interrupt Mask 0 : Mask all interrupts 1 : Unmask all interrupts [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>GUSBCFG</name>
          <description>USB Configuration , Global USB Configuration. DS §5.6.5.2 p.338. Reset 0x1440 (DS).</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00001440</resetValue>
          <fields>
            <field>
              <name>corrtxpkt</name>
              <description>Corrupt Tx Packet Only used in debug mode, do not set it to 1 [reset 0x0] [access RW]</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>USBTrdTim</name>
              <description>USB Turnaround Time Calculation formula: (4*AHB_CLK + 1*PHY_CLK)/PHY_CLK [reset 0x5] [access RW]</description>
              <bitOffset>10</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PHYSel</name>
              <description>USB2.0 HSPHY or USB1.1 FS Serial Transceiver 1 : USB1.1 FS Serial Transceiver 0 : USB2.0 high-speed PHY [reset 0x1] [access RO]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>FSIntf</name>
              <description>FS Serial Interace Select 0 : 6-pin unidirectional FS interface 1 : 3-pin bidirectional FS interface [reset 0x0] [access RW]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TOutCal</name>
              <description>HS/FS Timeout Calibration (USB defines the FS mode timeout value as 16-18 bits time , which is the delay added to accommodate different PHY delays ) Calculation formula: 0.25bit time * The value [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>GRSTCTL</name>
          <description>Reset , global reset control register. DS §5.6.5.3 p.338. Reset 0x80000000 (DS).</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x80000000</resetValue>
          <fields>
            <field>
              <name>AHBIdle</name>
              <description>AHB master idle [reset 0x1] [access RO]</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>DMAReq</name>
              <description>DMA request signal (debug) [reset 0x0] [access RO]</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TxFNum</name>
              <description>TxFIFO number to flush with TxFFlsh: 0 = non-periodic/TxFIFO0, n = TxFIFOn ... 0x10 = all TxFIFOs. Printed FxFNum [reset 0x0] [access RW]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TxFFlsh</name>
              <description>TxFIFO flush; no TxFIFO access may be in progress; wait for self-clear (8 phy_clk or hclk) before the next access [reset 0x0] [access WS/SC]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>RxFFlsh</name>
              <description>RxFIFO flush; same rules as TxFFlsh [reset 0x0] [access WS/SC]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>HSftRst</name>
              <description>hclk-domain soft reset [reset 0x0] [access WS/SC]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>CSftRst</name>
              <description>hclk and phy_clk domain soft reset [reset 0x0] [access WS/SC]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>GINTSTS</name>
          <description>Interrupt , global interrupt status register. DS §5.6.5.4 p.340.</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>WkUpInt</name>
              <description>Resume/Remote Wakeup Dectected interrupt Dev mode: detect USB Set when Resume [reset 0x0] [access RO/WC]</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>ConIDStsChng</name>
              <description>Connector ID Status Change interrupt [reset 0x0] [access RO/WC]</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>FetSusp</name>
              <description>Data Fetch Suspended , valid only in DMA mode [reset 0x0] [access RO/WC]</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>incomplSOOUT</name>
              <description>Incomplete Isochronous OUT Transfer (dev- only) dev mode, there is at least one ISO OUT EP has not completed transmission in the current frame , and is set at the same time as the EOPF interrupt [reset 0x0] [access RO/WC]</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>incompleSOIN</name>
              <description>Incomplete Isochronous IN Transfer (dev- only) dev mode, there is at least one ISO IN EP has not completed transmission in the current frame , and is set at the same time as the EOPF interrupt [reset 0x0] [access RO/WC]</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>OEPInt</name>
              <description>OUT Endpoints interrupt (dev- only) dev mode, if there is OUT Set when the EP interrupt is not processed. The application must read DAINT and DOEPINTn to determine the specific interrupt event to be processed. [reset 0x0] [access RO]</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>IEPInt</name>
              <description>IN Endpoints interrupt (dev- only) dev mode, if there is IN Set when the EP interrupt is not processed. The application must read DAINT and DIEPINTn to determine the specific interrupt event to be processed. [reset 0x0] [access RO]</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>EPMis</name>
              <description>Endpoint Mismatch interrupt (dev- only) Only valid when shared FIFO is in operation. After token , FIFO When the data in does not match, it triggers [reset 0x0] [access RO/WC]</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>EOPF</name>
              <description>End of Periodic Frame interrupt (dev- only) Reach the Periodic value set by DCFG.PerFrInt Frame Triggered when the Interval period is reached [reset 0x0] [access RO/WC]</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
