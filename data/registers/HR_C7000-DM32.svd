    <peripheral>
      <name>i8080</name>
      <description>i8080-style parallel LCD bus controller (DS §5.3, p.264-268). Drives the DM-32's ST7789V-class panel controller (identified 2026-10-11 from the stock init sequence, which uses ST7789V-only commands B2/B7/BB/C0/C2/C3/C6/D0; earlier notes said HX8353E, which rested only on shared MIPI DCS commands): INDEX (+0x0) carries panel commands and DATA (+0x4) pixel/parameter data. FW: 5 direct access sites (init in the LCD driver) plus base literals at 0x0303dad0, 0x0304242c.</description>
      <groupName>I80</groupName>
      <baseAddress>0x12000000</baseAddress>
      <addressBlock><offset>0x0</offset><size>0x10000</size><usage>registers</usage></addressBlock>
      <registers>
        <register>
          <name>INDEX</name>
          <description>Addressing register. DS §5.3.5.1 p.266. FW: 0 reads, 1 write. Reset 0x0 (DS).</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>INDEX0</name>
              <description>Port Index Register [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DATA</name>
          <description>Data register. DS §5.3.5.2 p.266. FW: 0 reads, 1 write. Reset 0x0 (DS).</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DATA0</name>
              <description>Port data register [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WCFG</name>
          <description>Write timing parameter configuration. DS §5.3.5.3 p.266. FW: 0 reads, 1 write. Reset 0x10101 (DS).</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00010101</resetValue>
          <fields>
            <field>
              <name>TCNT_WHT0</name>
              <description>Write strobe tail invalid cycle [reset 0x1] [access RW]</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TCNT_WL0</name>
              <description>Write strobe valid period [reset 0x1] [access RW]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TCNT_WHF0</name>
              <description>Write strobe header invalidation cycle [reset 0x1] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RCFG</name>
          <description>Read timing parameter configuration. DS §5.3.5.4 p.266. The datasheet prints the reserved row as [31:0], overlapping the fields; reserved is [31:24] by analogy with WCFG. Reset 0x10101 (DS).</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00010101</resetValue>
          <fields>
            <field>
              <name>TCNT_RHT0</name>
              <description>Read strobe tail inactive cycles (port 0) [reset 0x1] [access RW]</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TCNT_RL0</name>
              <description>Read strobe active period (port 0) [reset 0x1] [access RW]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RCNT_RHF0</name>
              <description>Read strobe head inactive cycles (port 0). Printed RCNT_RHF0; by symmetry with TCNT_WHF0 probably TCNT_RHF0 [reset 0x1] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SCFG</name>
          <description>Configuration registers. DS §5.3.5.5 p.268. Reset 0x0 (DS).</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>P0_SCFG</name>
              <description>Port Configuration Register [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UNDOC_0x28</name>
          <description>Not in the datasheet's I80 register table. The stock firmware reads and writes it (FW: 1 read, 1 write). Role unknown.</description>
