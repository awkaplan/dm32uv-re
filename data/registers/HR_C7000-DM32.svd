              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>card_voltage_b</name>
              <description>Card regulator B voltage setting, output to card_volt_b (optional; usable as a general output port) [reset 0x0] [access RW]</description>
              <bitOffset>20</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>card_voltage_a</name>
              <description>Card regulator A voltage setting, output to card_volt_a. Printed card_voltage_b (duplicate of [23:20]); DW_mobile_storage names this card_voltage_a [reset 0x0] [access RW]</description>
              <bitOffset>16</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ceata_device_interrupt_status</name>
              <description>0: CE-ATA device interrupts disabled; 1: enabled [reset 0x0] [access RW]</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
