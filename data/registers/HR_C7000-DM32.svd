              <description>16 S D memory or 1 Zhang MMC Memory low power control 0 : Non-low power mode; 1 : Low power mode , the project only configures bit[16] , and all other bits are fixed to 0 [reset 0x0] [access RW]</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>cclk_enable</name>
              <description>16 S D memory or 1 Zhang MMC Memory clock enable control , 0 : Clock is invalid; 1 : Clock is enabled The project only configures bit[0] , and all other bits are fixed to 0 [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
