              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ADC_CHA_VLD</name>
              <description>In continuous scan mode, whether channel A is valid. 0: invalid; 1: valid [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
