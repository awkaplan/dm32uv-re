      <baseAddress>0x14030000</baseAddress>
      <addressBlock><offset>0x0</offset><size>0x10000</size><usage>registers</usage></addressBlock>
      <interrupt><name>UART0</name><description>PIC source 12 (bit 12 of PIC_MASK/INT_ST), default CPU vector 44 (DS Table 30, p.168-169)</description><value>12</value></interrupt>
      <registers>
        <register>
          <name>RBR</name>
          <description>Receive buffer register. DS §5.4.5.1 p.274. FW: 2 reads, 7 writes. Reset 0x0 (DS).</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RBR</name>
              <description>Receive buffer: data received on the serial input port [reset 0x0] [access RO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>THR</name>
          <alternateRegister>RBR</alternateRegister>
          <description>Transmit Holding Register. DS §5.4.5.2 p.275. FW: 2 reads, 7 writes. Reset 0x0 (DS).</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>THR</name>
              <description>Transmit holding: data sent to the serial port [reset 0x0] [access WO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DLL</name>
          <alternateRegister>RBR</alternateRegister>
          <description>Frequency division latch low. DS §5.4.5.3 p.275. FW: 2 reads, 7 writes. Reset 0x0 (DS).</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DLL</name>
              <description>Divisor latch low: low 8 bits of the baud-rate divisor (requires LCR.DLAB=1) [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IER</name>
          <description>Interrupt enable register. DS §5.4.5.5 p.275. FW: 0 reads, 2 writes. Reset 0x0 (DS).</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PTIME</name>
              <description>Used to enable/disable the generation of THRE interrupt. 0 = disabled 1 = enabled [reset 0x0] [access RW]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EDSSI</name>
              <description>Enable modem status interrupt. 0 = disabled 1 = enabled [reset 0x0] [access RW]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ELSI</name>
              <description>Enable receiver line status interrupt 0 = disabled 1 = enabled [reset 0x0] [access RW]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ETBEI</name>
              <description>Enable transmit holding register empty interrupt 0 = disabled 1 = enabled [reset 0x0] [access RW]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ERBFI</name>
              <description>Enable receive data available interrupt and character timeout interrupt ( FIFO mode ) 0 = disabled 1 = enabled [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DLH</name>
          <alternateRegister>IER</alternateRegister>
          <description>Frequency division latch high. DS §5.4.5.4 p.275. FW: 0 reads, 2 writes. Reset 0x0 (DS).</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DLH</name>
              <description>Divisor latch high: high 8 bits of the baud-rate divisor (requires LCR.DLAB=1) [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IIR</name>
          <description>Interrupt Flag Register. DS §5.4.5.6 p.277. FW: 0 reads, 2 writes. Reset 0x1 (DS).</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000001</resetValue>
          <fields>
            <field>
              <name>FIFOSE</name>
              <description>FIFOs enabled. 00: disabled; 11: enabled [reset 0x0] [access RO]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>IID</name>
              <description>Interrupt ID, highest-priority pending: 0001 none; 0110 receiver line status (highest; cleared by reading LSR); 0100 received data available (second; cleared when RX FIFO drops below threshold); 1100 character timeout (second; cleared by reading RBR); 0010 THR empty (third; cleared by reading IIR or TX FIFO above threshold); 0111 busy detect (not available in 16550-compatible mode) [reset 0x1] [access RO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>FCR</name>
          <alternateRegister>IIR</alternateRegister>
          <description>FIFO Controller Registers. DS §5.4.5.7 p.279. FW: 0 reads, 2 writes. Reset 0x0 (DS).</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RT</name>
              <description>RCVR trigger, RX-data-available threshold. 00: 1 char; 01: 1/4 FIFO (4); 10: 1/2 FIFO (8); 11: FIFO depth - 2 (14) [reset 0x0] [access WO]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>TET</name>
              <description>TX empty trigger. 00: FIFO empty; 01: 2 chars; 10: 1/4 FIFO (4); 11: 1/2 FIFO (8) [reset 0x0] [access WO]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>DMAM</name>
              <description>DMA mode. 0: mode 0; 1: mode 1 [reset 0x0] [access WO]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>XFIFOR</name>
              <description>XMIT FIFO reset [reset 0x0] [access WO]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>RFIFOR</name>
              <description>RCVR FIFO reset [reset 0x0] [access WO]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>FIFOE</name>
              <description>FIFO enable (both TX and RX FIFOs) [reset 0x0] [access WO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LCR</name>
          <description>Line Control Register. DS §5.4.5.8 p.279. FW: 4 reads, 2 writes. Bit 5 (stick parity) is reserved and reads as 0. Reset 0x0 (DS).</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DLAB</name>
              <description>Divisor latch access: enables DLL/DLH at offsets 0x00/0x04. Must be cleared after the baud rate is set [reset 0x0] [access RW]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BC</name>
              <description>Break control: 1 forces the serial output to the break state. Printed 'Break' [reset 0x0] [access RW]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EPS</name>
              <description>Even parity select. 1: even; 0: odd [reset 0x0] [access RW]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PEN</name>
              <description>Parity enable. 0: disabled; 1: enabled [reset 0x0] [access RW]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>STOP</name>
              <description>Stop bits. 0: 1 stop bit; 1: 1.5 stop bits when DLS=0, else 2. The receiver checks only the first stop bit [reset 0x0] [access RW]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DLS</name>
              <description>Data length. 00: 5 bits; 01: 6; 10: 7; 11: 8 [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MCR</name>
          <description>Modem Control registers. DS §5.4.5.9 p.281. Reset 0x0 (DS).</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SIRE</name>
              <description>SIR mode enabled [reset 0x0] [access RW]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>AFCE</name>
              <description>Automatic flow control [reset 0x0] [access RW]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LoopBack</name>
              <description>Loop Mode [reset 0x0] [access RW]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OUT2</name>
              <description>OUT2 [reset 0x0] [access RW]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OUT1</name>
              <description>OUT1 [reset 0x0] [access RW]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RTS</name>
              <description>RTS [reset 0x0] [access RW]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DTR</name>
              <description>DTR [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LSR</name>
          <description>Line Status Register. DS §5.4.5.10 p.281. FW: 5 reads, 0 writes. Reset 0x60 (DS).</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000060</resetValue>
          <fields>
            <field>
              <name>RFE</name>
              <description>Receiver FIFO error: at least one parity, framing or break error in the FIFO [reset 0x0] [access RO]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TEMT</name>
              <description>Transmitter empty: in FIFO mode, set when both the transmit shift register and the FIFO are empty [reset 0x1] [access RO]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>THRE</name>
              <description>THR empty. With IER.PTIME=1 it means the TX FIFO is FULL; with IER.PTIME=0 it means the TX FIFO is EMPTY [reset 0x1] [access RO]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BI</name>
              <description>Break interrupt: serial input held at 0 for longer than one character time [reset 0x0] [access RO]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>FE</name>
              <description>Framing error: no valid stop bit received [reset 0x0] [access RO]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>PE</name>
              <description>Parity error [reset 0x0] [access RO]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>OE</name>
              <description>Overrun error: data received while the FIFO was full; the FIFO keeps its data, the shift-register byte is lost [reset 0x0] [access RO]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>DR</name>
              <description>Data ready: at least one character in RBR or the RX FIFO [reset 0x0] [access RO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>USR</name>
          <description>FIFO Status Flags. DS §5.4.5.11 p.283. FW: 4 reads, 0 writes. Reset 0x0 (DS).</description>
          <addressOffset>0x7c</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RFF</name>
              <description>Receive FIFO full [reset 0x0] [access RO]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RFNE</name>
              <description>Receive FIFO not empty [reset 0x0] [access RO]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TFE</name>
              <description>Transmit FIFO empty [reset 0x0] [access RO]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TFNF</name>
              <description>Transmit FIFO not full [reset 0x0] [access RO]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BUSY</name>
              <description>UART busy. The datasheet says only 'This bit is invalid' [reset 0x0] [access RO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TFL</name>
          <description>The amount of data in the transmit FIFO. DS §5.4.5.12 p.285. Reset 0x0 (DS).</description>
          <addressOffset>0x80</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>TFL</name>
              <description>Transmit FIFO level (number of entries). Printed width [FIFO_ADDR_WIDTH:0]; [4:0] assumes the 16-deep FIFO implied by FCR's thresholds (INFERRED) [reset 0x0] [access RO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RFL</name>
          <description>DS §5.4.5.13 p.285. Reset 0x0 (DS).</description>
          <addressOffset>0x84</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RFL</name>
              <description>Receive FIFO level (number of entries). Width INFERRED as for TFL [reset 0x0] [access RO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="UART0">
      <name>UART1</name>
      <description>UART1. Same register table as UART0 (DS Register Table 16, p.274). FW: 24 access sites.</description>
      <baseAddress>0x14040000</baseAddress>
      <interrupt><name>UART1</name><description>PIC source 10 (bit 10 of PIC_MASK/INT_ST), default CPU vector 42 (DS Table 30, p.168-169)</description><value>10</value></interrupt>
    </peripheral>
    <peripheral derivedFrom="UART0">
      <name>UART2</name>
      <description>UART2. Same register table as UART0 (DS Register Table 17, p.274). FW: no access found.</description>
      <baseAddress>0x14050000</baseAddress>
      <interrupt><name>UART2</name><description>PIC source 11 (bit 11 of PIC_MASK/INT_ST), default CPU vector 43 (DS Table 30, p.168-169)</description><value>11</value></interrupt>
    </peripheral>
    <peripheral derivedFrom="UART0">
      <name>UART3</name>
      <description>UART3. Not tabulated in the v2.7 guide (only UART0-2 are), but DRV gives UART3's offsets explicitly and they match UART0's. FW: no access found.</description>
      <baseAddress>0x14090000</baseAddress>
      <interrupt><name>UART3</name><description>PIC source 13 (bit 13 of PIC_MASK/INT_ST), default CPU vector 45 (DS Table 30, p.168-169)</description><value>13</value></interrupt>
    </peripheral>
    <peripheral>
      <name>I2C0</name>
      <description>I2C0, Synopsys DesignWare APB I2C master/slave (DS §5.1, p.218-243). FW: no direct access or base literal found in program flash. QEMU docs record the ALPU-MP anti-clone handshake (I2C address 0x7a) on this controller; the IRAM code also contains a bit-banged GPIO I2C routine addressing 0x7a. Which path the stock firmware uses is not settled here.</description>
      <groupName>I2C</groupName>
      <baseAddress>0x14060000</baseAddress>
      <addressBlock><offset>0x0</offset><size>0x10000</size><usage>registers</usage></addressBlock>
      <interrupt><name>I2C0</name><description>PIC source 8 (bit 8 of PIC_MASK/INT_ST), default CPU vector 40 (DS Table 30, p.168-169)</description><value>8</value></interrupt>
      <registers>
        <register>
          <name>IC_CON</name>
          <description>I2C Control registers. DS §5.1.6.1 p.226. Reset 0x7d (DS).</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000007d</resetValue>
          <fields>
            <field>
              <name>IC_SLAVE_DISABLE</name>
              <description>I2C functions as a slave after reset. 0: slave enabled; 1: slave disabled [reset 0x1] [access RW]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>IC_RESTART_EN</name>
              <description>As master, whether RESTART is supported. 0: off; 1: enabled [reset 0x1] [access RW]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>IC_10BITADDR_MASTER</name>
              <description>As master, address mode. 0: 7-bit; 1: 10-bit [reset 0x1] [access RW]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>IC_10BITADDR_SLAVE</name>
              <description>As slave, address mode the I2C responds to. 0: 7-bit; 1: 10-bit [reset 0x1] [access RW]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SPEED</name>
              <description>Speed mode. 1: standard (100 kbit/s); 2: fast (400 kbit/s); 3: high speed (3.4 Mbit/s, not supported) [reset 0x2] [access RW]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MASTER_MODE</name>
              <description>Master enable. 0: master off; 1: master enabled [reset 0x1] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IC_TAR</name>
          <description>I2C Destination Address Register. DS §5.1.6.2 p.228. Reset 0x55 (DS).</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000055</resetValue>
          <fields>
            <field>
              <name>SPECIAL</name>
              <description>Indicates whether the software executes a general call or start byte command. ( Not supported These two functions ) [reset 0x0] [access RW]</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>GC_OR_START</name>
              <description>only when bit 11 is set to 1. It indicates whether the software is executing a general call or a start byte command. 0 : Broadcast call 1 : Start byte [reset 0x0] [access RW]</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>IC_TAR</name>
              <description>Indicates the target slave address when I2C is used as the master . [reset 0x55] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>10</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IC_DATA_CMD</name>
          <description>I2C Send and receive data buffers and. DS §5.1.6.3 p.228. Reset 0x0 (DS).</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CMD</name>
              <description>I2C is used as a master , read and write control bits. 1 : Read 0 : Write [reset 0x0] [access WO]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>DAT</name>
              <description>Data sent to or received from the I2C bus . [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IC_FS_SCL_HCNT</name>
          <description>Fast SCL High level count. DS §5.1.6.4 p.228. Reset 0x5a (DS).</description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000005a</resetValue>
          <fields>
