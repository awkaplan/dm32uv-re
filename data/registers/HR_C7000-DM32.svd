              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DAC_PD_MODE_AEN</name>
              <description>DAC channel A low power mode enable. 1 : Enable; 0 : Disable Break [reset 0x1] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
