        <register>
          <name>ADC_PD_SEOC_TIME</name>
          <description>ADC Power-off time register. DS §5.9.5.11 p.419. FW: 0 reads, 1 write. Reset 0xa20 (DS).</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000a20</resetValue>
          <fields>
            <field>
              <name>EOC_PD_TIME</name>
              <description>EOC and the rising edge of PD . the configured value is smaller than the default value, the default value is used. [reset 0xa] [access RW]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PD_SOC_TIME</name>
              <description>SOC and the falling edge of PD . the configured value is smaller than the default value, the default value is used. [reset 0x20] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
