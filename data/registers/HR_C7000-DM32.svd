              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RD_REQ</name>
              <description>When I2C is used as a slave and other masters read data from I2C , this error will occur. When this interrupt is valid, I2C pulls SCL low and keeps it until the CPU responds to this interrupt and writes data to the IC_DATA_CMD register. [reset 0x0] [access RO]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TX_EMPTY</name>
              <description>When the transmit FIFO data is lower than or equal to the threshold set in the IC_TX_TL register When the transmit FIFO threshold is exceeded, a transmit FIFO threshold interrupt will be generated. [reset 0x0] [access RO]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TX_OVER</name>
              <description>When the transmit FIFO reaches the set depth and the processor continues to write data, Generates a transmit overflow interrupt. [reset 0x0] [access RO]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RX_FULL</name>
              <description>When the receive FIFO data is greater than or equal to the threshold set by the IC_RX_TL register When the receive FIFO threshold value is reached, a receive FIFO threshold interrupt will be generated. [reset 0x0] [access RO]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RX_OVER</name>
              <description>When the receive FIFO is full and continues to receive data, an overflow interrupt is generated. [reset 0x0] [access RO]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RX_UNDER</name>
              <description>When the receive FIFO is empty and the processor reads data, an underflow interrupt is generated. [reset 0x0] [access RO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
