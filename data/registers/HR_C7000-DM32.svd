        <register>
          <name>DIEPCTL0</name>
          <description>EP0. DS §5.6.5.27 p.361. Reset 0x8000 (DS).</description>
          <addressOffset>0x900</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00008000</resetValue>
          <fields>
            <field>
              <name>EPEna</name>
              <description>Endpoint Enable In non- SG-DMA mode, when set, indicates data is ready. The soft core automatically clears this bit before asserting any of the following interrupts: endpoint disable transfer completed [reset 0x0] [access WS/SC]</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>EPDis</name>
              <description>Endpoint diable , can only be used after setting EPEna When set, it forces the data transmission to be terminated ( even if the data has not yet ended ) . The soft core automatically clears this bit before setting the Endpoint disable interrupt. [reset 0x0] [access WS/SC]</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>SNAK</name>
              <description>Set NAK When set, the control port responds with NAK [reset 0x0] [access WO]</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>CNAK</name>
              <description>Clear NAK , clear the SNAK bit [reset 0x0] [access WO]</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>TxFNum</name>
              <description>Specify a dedicated TxFIFO number Indicates allocation to IN EP0 TxFIFO number, must be zero [reset 0x0] [access RW]</description>
              <bitOffset>22</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>Stall</name>
              <description>Stall handshake The application can only set this bit after receiving the SETUP signaling. This bit has higher priority than NAK , Global Non-Periodic IN NAK and Global OUT NAK bits. [reset 0x0] [access WS/SC]</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>EPType</name>
              <description>Port type, EP0 is only used for control [reset 0x0] [access RO]</description>
              <bitOffset>18</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>NAKSts</name>
              <description>NAK status 0 : The soft core sends a non-NAK handshake packet based on the FIFO status 1 : The soft core sends a NAK handshake packet When set, the soft core forces the termination of data transfer [reset 0x0] [access RO]</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
