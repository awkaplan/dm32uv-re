              <description>Back2BackSETup (CTRL is valid ) the soft core receives three or more consecutive SETUP packets [reset 0x0] [access RO/WC]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>OUTTknEPdis</name>
              <description>OUT Token Received when EP Disa (CTRL valid ) OUT is received , EP is not enabled yet [reset 0x0] [access RO/WC]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>SetUp</name>
              <description>SETUP Phase DONE (CTRL is valid ) SETUP Triggered when the Stage is completed and there are no subsequent SETUP packets. After this interrupt, the application can start parsing the SETUP packet. [reset 0x0] [access RO/WC]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>AHBErr</name>
              <description>AHB Error In internal DMA mode, trigger when AHB read or write error occurs [reset 0x0] [access RO/WC]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>EPDisbld</name>
              <description>Endpoint Disable Triggered when the port is closed [reset 0x0] [access RO/WC]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>XferCompl</name>
              <description>Transfer Complete The specified number of transfers has completed [reset 0x0] [access RO/WC]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DOEPTSIZ4</name>
