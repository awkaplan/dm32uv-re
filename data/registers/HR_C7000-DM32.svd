            <field>
              <name>inactout</name>
              <description>pwm The output level when not enabled. [reset 0x0] [access RW]</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>fpout</name>
              <description>pwm Output level of the first phase in one cycle [reset 0x0] [access RW]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>evtrig</name>
              <description>In ONE_SHOT Event trigger mode in mode 1: rising edge trigger 2: Falling edge trigger 0,3: Normal mode, that is, not PWM according to external signals Signal output [reset 0x0] [access RW]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>mode</name>
              <description>PWM Mode, 1:ONE_SHOT model 2: CONTINUOUS model 0,3: Reserved, no PWM Waveform output [reset 0x0] [access RW]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>inten</name>
              <description>Interrupt enable [reset 0x0] [access RW]</description>
