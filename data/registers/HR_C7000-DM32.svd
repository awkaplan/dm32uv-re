          <addressOffset>0xb90</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RxDPID</name>
              <description>Received Data PID (ISO valid ) PID number of the last packet 'h0: DATA0 'h1: DATA2 'h2: DATA1 'h3: MDATA [reset 0x0] [access RO]</description>
              <bitOffset>29</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>PktCnt</name>
              <description>Packet Count Specify the number of transaction packets. When RxFIFO receives a packet, the segment is automatically reduced by 1. [reset 0x0] [access RW]</description>
              <bitOffset>19</bitOffset>
              <bitWidth>10</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>XferSize</name>
              <description>Transfer Size The total byte length of this transaction on the port. Each time a byte is read from the RxFIFO , the segment is automatically reduced by 1 and an interrupt is triggered when it reaches zero. [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>19</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DOEPDMA4</name>
