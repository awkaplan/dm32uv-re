              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ADC_CHD_VLD</name>
              <description>In continuous scan mode, whether channel D is valid. 0 : invalid; 1 : valid. [reset 0x0] [access RW]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ADC_CHC_VLD</name>
              <description>In continuous scan mode, is channel C valid? 0 : invalid; 1 : valid. [reset 0x0] [access RW]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ADC_CHB_VLD</name>
