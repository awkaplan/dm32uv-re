    </peripheral>
    <peripheral derivedFrom="SPI_Master0">
      <name>SPI_Slave0</name>
      <description>SPI slave 0. INFERRED to share the SSI register map: the datasheet has no table for the slave instances, only slave-mode interpretations of CTRLR0 in the SPI table, and the Chinese edition notes the slave FIFO depth is 8 (v2.7 zh p.145: 'spi_slave FIFO深度是8'). FW: no access found.</description>
      <baseAddress>0x14120000</baseAddress>
      <interrupt><name>SlaveSPI0</name><description>PIC source 34 (bit 2 of PIC_MASK_1/INT_ST_1), default CPU vector 66 (DS Table 30, p.168-169)</description><value>34</value></interrupt>
    </peripheral>
    <peripheral derivedFrom="SPI_Master0">
      <name>SPI_Slave1</name>
      <description>SPI slave 1. INFERRED SSI register map, as SPI_Slave0. FW: no access found.</description>
      <baseAddress>0x14130000</baseAddress>
      <interrupt><name>SlaveSPI1</name><description>PIC source 35 (bit 3 of PIC_MASK_1/INT_ST_1), default CPU vector 67 (DS Table 30, p.168-169)</description><value>35</value></interrupt>
    </peripheral>
    <peripheral derivedFrom="SPI_Master0">
      <name>SPI_Slave2</name>
      <description>SPI slave 2. INFERRED SSI register map, as SPI_Slave0. FW: no access found.</description>
      <baseAddress>0x14140000</baseAddress>
      <interrupt><name>SlaveSPI2</name><description>PIC source 36 (bit 4 of PIC_MASK_1/INT_ST_1), default CPU vector 68 (DS Table 30, p.168-169)</description><value>36</value></interrupt>
    </peripheral>
    <peripheral derivedFrom="SPI_Master0">
      <name>SPI_Master3</name>
      <description>SPI master 3, 'EFUSE only' per the memory map (DS p.134). Not tabulated in any datasheet edition, but the stock firmware drives it with exactly the SSI register offsets (FW: 23 sites at 0x0/0x4/0x8/0x10/0x14/0x18/0x1c/0x28/0x2c/0x60, fourth entry of the SSI base table at 0x030ada0c), so the layout is firmware-confirmed. What it is attached to on the DM-32 is not established. No PIC interrupt source.</description>
      <baseAddress>0x14150000</baseAddress>
    </peripheral>
    <peripheral>
      <name>SDIO</name>
      <description>SD/SDIO host, Synopsys DesignWare Mobile Storage (DS §5.5, p.285-325; FIFO depth 128, data FIFO window from +0x200). FW: no access found; QEMU: reports no card, as on the radio.</description>
      <groupName>SDIO</groupName>
      <baseAddress>0x15000000</baseAddress>
      <addressBlock><offset>0x0</offset><size>0x10000</size><usage>registers</usage></addressBlock>
      <interrupt><name>SDIO</name><description>PIC source 20 (bit 20 of PIC_MASK/INT_ST), default CPU vector 52 (DS Table 30, p.168-169)</description><value>20</value></interrupt>
      <registers>
        <register>
          <name>CTRL</name>
          <description>Control registers. DS §5.5.5.1 p.305. Note: H/S Represents hardware reset and software reset Reset 0x0 (DS).</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
