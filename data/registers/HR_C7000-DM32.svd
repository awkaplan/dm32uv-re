    <peripheral derivedFrom="SPI_Master0">
      <name>SPI_Master1</name>
      <description>SPI master 1. Same register table as SPI0 (DS Register Table 12, p.252). FW: second entry of the SSI base table at 0x030ada04; no attached device identified.</description>
      <baseAddress>0x140b0000</baseAddress>
      <interrupt><name>SPI1</name><description>PIC source 22 (bit 22 of PIC_MASK/INT_ST), default CPU vector 54 (DS Table 30, p.168-169)</description><value>22</value></interrupt>
    </peripheral>
    <peripheral>
      <name>PWM</name>
      <description>PWM, three channels at a 0x20 stride plus a shared interrupt status at 0xff0 (DS §5.8, p.385-400). FW: the base is built arithmetically (at 0x0301c1bc), which a literal/movih sweep cannot see; channel 0 drives the LCD backlight at 1 kHz with seven duty levels.</description>
      <groupName>PWM</groupName>
      <baseAddress>0x140c0000</baseAddress>
      <addressBlock><offset>0x0</offset><size>0x10000</size><usage>registers</usage></addressBlock>
      <interrupt><name>PWM</name><description>PIC source 18 (bit 18 of PIC_MASK/INT_ST), default CPU vector 50 (DS Table 30, p.168-169)</description><value>18</value></interrupt>
