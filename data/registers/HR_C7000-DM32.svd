        <register>
          <name>ADC_CTRL_STOP</name>
          <description>ADC Configuration registers. DS §5.9.5.9 p.417. FW: 0 reads, 3 writes. Reset 0x0 (DS).</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ADC_CTRL_RESET</name>
              <description>Write 1 to soft reset the controller, self- clearing [reset 0x0] [access WO]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>ADC_CTRL_STOP</name>
              <description>Only works in continuous scan mode. In continuous scan mode, it stops automatically scanning after scanning the last valid channel and clears itself to 0. (In continuous scan mode, writing 1 to this register can stop the automatic scanning function of adc_ctrl . It is necessary to rewrite the ADC_START and ADC_CH_VLD registers . to restart automatic scanning ) [reset 0x0] [access WO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
