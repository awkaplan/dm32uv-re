              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INEPnTxFStAddr</name>
              <description>IN EP TxFIFOn start address. Reset 0x100 for DIEPTXF1, 0x180 for DIEPTXF3 [reset 0x100] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
