        <register>
          <name>ADC_SCAN_TIME</name>
          <description>ADC Scan interval setting. DS §5.9.5.5 p.415. Reset 0x2c (DS).</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000002c</resetValue>
          <fields>
            <field>
              <name>SCAN_TIME</name>
              <description>Scan time interval setting, in units of clk number. The minimum configuration value is ( a d c _ e o c _ d _ t i m e + 1 2 , decimal number ) . If it is less than the minimum value, it is calculated according to the minimum value , and A DC_C T R L _ STAT E [ 3 ] is set, and the 0 x 2 0 register SCAN_TIME_ERR is set . Note : Before configuring this register, the 0 x 3 4 register must be configured first . [reset 0x2c] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ADC_START</name>
          <description>ADC start up. DS §5.9.5.6 p.415. FW: 0 reads, 1 write. Reset 0x0 (DS).</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ADC_START</name>
              <description>Write 1 to start the adc_ctrl module. In single scan mode, the next beat of the EOC signal will clear this bit to 0 ; in continuous scan mode, the adc_ctrl_stop register A write enable signal will clear this bit to 0. [reset 0x0] [access WO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ADC_CTRL_STATE</name>
          <description>ADC Control and Status Registers. DS §5.9.5.7 p.415. FW: 3 reads, 0 writes. Reset 0x0 (DS).</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>EOC_WIDTH_ERR</name>
              <description>Set when the EOC signal width is greater than one clk . Cleared to 0 for any value . [reset 0x0] [access R/W]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SOC_EOC_TIME_OUT</name>
              <description>Set when the interval between SOC and EOC is not equal to 11 clks . Write any value to clear 0. [reset 0x0] [access R/W]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SCAN_TIME_ERROR</name>
              <description>The ADC_SCAN_TIME register configuration value is less than the minimum value. The meaning value is cleared to 0 . [reset 0x0] [access R/W]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SAMP_FSM_STATE</name>
              <description>ADC_CTRL sampling data state machine state 9 : transition state, G_SAMPLE_S 8 : Sampling channel H data, G_SAMPLE_H . 7 : Sampling channel G data, G_SAMPLE_G . 6 : Sampling channel F data, G_SAMPLE_F . 5 : Sampling channel E data, G_SAMPLE_E . 4 : Sampling channel D data, G_SAMPLE_D . 3 : Sampling channel C status, G_SAMPLE_C . 2 : Sampling channel B status, G_SAMPLE_B . 1 : Sampling channel A status, G_SAMPLE_A . 0 : Idle state, G_IDLE [reset 0x0] [access RO]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ADC_CTRL_BUSY</name>
              <description>ADC_CTRL module status indication. 0 : idle 1 : busy [reset 0x0] [access RO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ADC_INTR_THRESHOLD</name>
          <description>ADC Interrupt initial value. DS §5.9.5.8 p.417. Printed ADC_INTR_THRESHOLE (typo); the reserved row is printed [31:0], overlapping the field. Reset 0x0 (DS).</description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
