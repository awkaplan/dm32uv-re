    <peripheral>
      <name>WDG</name>
      <description>Watchdog (DS §4.10, p.212-218). Write 0x5ada7200 to WDG_LOCK to unlock; feed by writing 0x55aadd22 to WDG_KNOCK; a timeout causes a full global reset (v2.2 manual p.32). Default timeout ~60 s, reset pulse ~20 ms. FW: base literal at 0x0305728c (no movih-built accesses). Neither magic value appears as a literal in program flash or the IRAM image, so whether and how stock feeds it is not established. QEMU: the dm32uv-qemu port maps it as plain RAM (it never bites).</description>
      <groupName>WDG</groupName>
      <baseAddress>0x14010000</baseAddress>
      <addressBlock><offset>0x0</offset><size>0x10000</size><usage>registers</usage></addressBlock>
      <registers>
        <register>
          <name>WDG_LOCK</name>
          <description>Watchdog Lock Register. DS §4.10.5.1 p.216. Reset 0x1 (DS).</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <fields>
            <field>
              <name>WDG_LOCK</name>
              <description>0x5ada_7200 to this register will enable write access to all registers, and writing other values to this register will disable write access to all registers. Reading this register will return the locked status: 0x0 : write allowed, unlocked 0x1 : write disabled, locked [reset 0x1] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDG_OT_LOAD_H</name>
          <description>DS §4.10.5.2 p.216. Reset 0x7 (DS).</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000007</resetValue>
          <fields>
            <field>
              <name>WDG_OT_LOAD_H</name>
              <description>The high initial value of the timeout counter. When the high initial value of the timeout counter overflows, it indicates Timeout, the default timeout is about 60s [reset 0x7] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDG_OT_LOAD_L</name>
          <description>DS §4.10.5.3 p.216. The datasheet marks WDG_OT_LOAD_L read-only while its high half (WDG_OT_LOAD_H) is read-write; possibly a datasheet error, not verified. Reset 0xc0000000 (DS).</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0xc0000000</resetValue>
          <fields>
            <field>
              <name>WDG_OT_LOAD_L</name>
              <description>The low initial value of the timeout counter, when the high counter overflows, Indicates timeout. The default timeout is about 60s . [reset 0xc0000000] [access RO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDG_RST_LOAD</name>
          <description>Watchdog reset time initial value. DS §4.10.5.4 p.218.</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>WDG_RST_LOAD</name>
              <description>The initial value of the watchdog reset time is reset after counting to 0x03ffffff Completed, the default reset time is about 20ms [reset 0x03f80000] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>25</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDG_EN</name>
          <description>Watchdog enable. DS §4.10.5.5 p.218. Reset 0x0 (DS).</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>WDG_EN</name>
              <description>Watchdog enable signal 0 : Watchdog is off and no watchdog reset is generated 1 : Watchdog is working. If the watchdog is not fed within the timeout period, a watchdog reset will occur. [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDG_KNOCK</name>
          <description>Watchdog feeding register. DS §4.10.5.6 p.218. Reset 0x0 (DS).</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>WDG_KNOCK</name>
              <description>Feed the dog signal, write 0x55aadd22 to feed the dog, watchdog timeout The counter restarts counting. [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>GPIOA</name>
