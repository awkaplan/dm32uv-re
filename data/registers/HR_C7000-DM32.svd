              <bitOffset>11</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DevAddr</name>
              <description>Dev address, the application software must set it after receiving the SetAddr instruction This paragraph [reset 0x0] [access RW]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>NZStsOUTHshk</name>
              <description>Status with non-zero length OUT handshake core 's response mode in the Status Stage when receiving a non-zero length OUT transaction in a control transfer 1 : Respond to the STALL packet and report the data to the application 0 : Report data to the application and respond to the handshake packet according to DCTL.NAK/STALL [reset 0x0] [access RW]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DevSpd</name>
              <description>Dev speed 'h0: HS(USB2.0 PHY CLK=30/60MHz) 'h1: FS(USB2.0 PHY CLK=30/60MHz) 'h2: LS(USB1.1 PHY CLK=6MHz) 'h3: FS(USB1.1 PHY CLK = 48MHz) [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
