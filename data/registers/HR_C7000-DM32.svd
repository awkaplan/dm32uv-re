          <fields>
            <field>
              <name>RXFLR</name>
              <description>Number of valid data in receive FIFO [reset 0x0] [access RO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IC_TX_ABRT_SOURCE</name>
          <description>I2C Transfer end status register. DS §5.1.6.25 p.240. Reset 0x0 (DS).</description>
          <addressOffset>0x80</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ABRT_SLVRD_INTX</name>
              <description>When I2C is used as a slave-transmitter , I2C requests to send data, and the processor Write and read commands to the transmit FIFO . [reset 0x0] [access RO]</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ABRT_SLV_ARBLOST</name>
              <description>As a Slave-Transmitter , when transmitting data to the master , the loss of cut. [reset 0x0] [access RO]</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ABRT_SLVFLUSH_TXFIFO</name>
              <description>As a Slave-Transmitter , I2C receives a read command and sends the data in the FIFO. There is already some data, and a TX_ABRT interrupt will be initiated to release the original data [reset 0x0] [access RO]</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ARB_LOST</name>
              <description>acting as a Master-Transmitter or Slave-Transmitter , the cut [reset 0x0] [access RO]</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ABRT_MASTER_DIS</name>
              <description>acting as a master , access the master when the master mode is shut down . [reset 0x0] [access RO]</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ABRT_10B_RD_NORSTRT</name>
              <description>As Master-Receiver , the RESTART function is turned off, but in the 10- bit Sending a read command in address mode [reset 0x0] [access RO]</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ABRT_SBYTE_NORSTRT</name>
              <description>As a master , RESTART is turned off, and the start byte is sent [reset 0x0] [access RO]</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ABRT_HS_NORSTRT</name>
              <description>As a master , the RESTART function is turned off, but an attempt is made to operate in high-speed mode Transfer data [reset 0x0] [access RO]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ABRT_SBYTE_ACKDET</name>
              <description>As a master , I2C sends the start byte, and the start byte is acked ( positive Normally, the start byte does not need ack ) [reset 0x0] [access RO]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ABRT_HS_ACKDET</name>
              <description>acting as a master , when I2C is in high-speed mode, the high-speed master code is acked . ack is required under normal circumstances ) [reset 0x0] [access RO]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ABRT_GCALL_READ</name>
              <description>As a master-tansmitter , I2C issues a general call when reading data [reset 0x0] [access RO]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ABRT_GCALL_NOACK</name>
              <description>As a master-tansmitter , the broadcast call address issued has no slave response. [reset 0x0] [access RO]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ABRT_TXDATA_NOACK</name>
              <description>acting as a master-tansmitter , the address sent gets ack , but then The data sent out does not receive ack from the slave [reset 0x0] [access RO]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ABRT_10ADDR2_NOACK</name>
              <description>As a master , the address mode is 10-bit mode, and the second address issued is No response was received from any slave . [reset 0x0] [access RO]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ABRT_10ADDR1_NOACK</name>
              <description>I2C is used as a master , the address mode is 10-bit mode, and the first The address did not receive any slave response. [reset 0x0] [access RO]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ABRT_7B_ADDR_NOACK</name>
              <description>I2C is used as a master , the address mode is 7-bit mode, and the address sent is not response was received from any slave . [reset 0x0] [access RO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IC_ENABLE_STATUS</name>
          <description>I2C Enable Status Register. DS §5.1.6.26 p.242. Reset 0x0 (DS).</description>
          <addressOffset>0x9c</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SLV_RX_DATA_LOST</name>
              <description>only when bit0 is 0 , indicating that in slave- reveive mode, after receiving &gt;= 1 byte of data, the I2C enable is turned off and the data transmission is abandoned. When it is set to 1 , it means that the transmission has entered the data stage and after receiving at least 1 byte of data, the I2C enable is turned off. Regardless of whether ack is received , the transmission is abandoned. When it is set to 0 , it means that when I2C is turned off, The data transmission phase has not yet begun. ( I2C is not supported as a slave .) [reset 0x0] [access RO]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>SLV_DISABLED_WHILE_BUSY</name>
              <description>This bit is valid only when bit0 is 0. It indicates that when I2C is used as a slave , the data transmission is terminated because the I2C enable is turned off. When I2C is receiving the address byte or Slave-Receiver mode, when I2C is receiving address and data bytes, the CPU writes 0 to the IC_ENABLE register , which will cause this position to be set to 1. (Not supported) I2C as slave ) [reset 0x0] [access RO]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>IC_EN</name>
              <description>Indicates whether I2C is enabled. 0 : I2C is inactive 1 : I2C enabled [reset 0x0] [access RO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IC_START</name>
          <description>Control data starts sending. DS §5.1.6.27 p.242. Reset 0x0 (DS).</description>
          <addressOffset>0xa0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>START</name>
              <description>Controls the I2C to start sending data. This register must be configured after the IC_ENABLE register is enabled. When there is data in the FIFO , writing 1 to this register will start sending data. 0 : Do not start 1 : Start [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="I2C0">
      <name>I2C1</name>
      <description>I2C1. Same register table as I2C0 (DS Register Table 10, p.224-226). FW: no access found.</description>
      <baseAddress>0x14070000</baseAddress>
      <interrupt><name>I2C1</name><description>PIC source 7 (bit 7 of PIC_MASK/INT_ST), default CPU vector 39 (DS Table 30, p.168-169)</description><value>7</value></interrupt>
    </peripheral>
    <peripheral derivedFrom="I2C0">
      <name>I2C2</name>
      <description>I2C2, dedicated to the internal RTC (memory map note, v2.2 manual p.10). Register layout INFERRED identical to I2C0/I2C1 (the v2.7 guide tabulates only I2C0 and I2C1); the offsets the firmware uses all match (FW: 24 sites at 0x0/0x4/0x10/0x30/0x40/0x6c/0x70/0xa0), as does DRV. The RTC is an I2C slave at 7-bit address 0x70 behind this controller, NOT memory-mapped: its 24 byte registers (RTC_VAL_*, RTC_MATCH_*, RTC_LOAD_*, RTC_CCR, RTC_RSTAT, RTC_CLKDIV_*, RTC_SOFT_RST_N at RTC addresses 0x00-0x17) are documented in DS §4.9 (p.200-212) and tabulated in the README accompanying this map, and are reached with IC_DATA_CMD transactions. RTC interrupt: PIC source 19 (vector 51).</description>
      <baseAddress>0x14080000</baseAddress>
      <interrupt><name>I2C2</name><description>PIC source 9 (bit 9 of PIC_MASK/INT_ST), default CPU vector 41 (DS Table 30, p.168-169)</description><value>9</value></interrupt>
    </peripheral>
    <peripheral>
      <name>SPI_Master0</name>
      <description>SPI master 0, Synopsys DesignWare APB SSI (DS §5.2, p.243-264; FIFO depth 128). On the DM-32 this is the bus to the 16 MB W25Q128 data flash (chip-select 0x12) holding the codeplug and per-unit calibration (QEMU: dm32uv-qemu dm32_ssi; Winbond W25Q128JV datasheet). FW: first entry of the SSI driver's base table at 0x030ada00 = {SPI_Master0, SPI_Master1, SPI2, SPI_Master3, 0x04000000}, plus 4 direct sites.</description>
      <groupName>SSI</groupName>
      <baseAddress>0x140a0000</baseAddress>
      <addressBlock><offset>0x0</offset><size>0x10000</size><usage>registers</usage></addressBlock>
      <interrupt><name>SPI0</name><description>PIC source 16 (bit 16 of PIC_MASK/INT_ST), default CPU vector 48 (DS Table 30, p.168-169)</description><value>16</value></interrupt>
      <registers>
        <register>
          <name>CTRLR0</name>
          <description>Transmission mode and frame length. DS §5.2.5.1 p.254. The datasheet gives master and slave interpretations of bits [10] and [5:0] in one table; the master view is used for the field list, the slave view is recorded in each field's description. Reset 0x7 (DS).</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000007</resetValue>
          <fields>
            <field>
              <name>SRL</name>
              <description>Self-loop (loopback) test mode [reset 0x0] [access RW]</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ENDIAN</name>
              <description>Master: endian control, 1: big endian; 0: little endian. Slave view of this bit: SLV_OE, slave txd output enable (0: enable; 1: disable). Printed as 'e ENDING (as master)' [reset 0x0] [access RW]</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TMOD</name>
              <description>Transfer mode. 00: transmit &amp; receive; 01: transmit only; 10: receive only; 11: EEPROM read (master only) [reset 0x0] [access RW]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SCPOL</name>
              <description>Clock polarity: level of SCLK when inactive [reset 0x0] [access RW]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SCPH</name>
              <description>Clock phase. 0: sample on first SCLK edge; 1: on second edge [reset 0x0] [access RW]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>M2L</name>
              <description>Bit order. 0: MSB first; 1: LSB first. Slave view of [5:4]: FRF, serial protocol, 00 = Motorola SPI (fixed) [reset 0x0] [access RW]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DFS</name>
              <description>Data frame size (frame length - 1). Slave view: DFS is [3:0], reset 0x7 [reset 0x7] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CTRLR1</name>
          <description>Number of received data frames. DS §5.2.5.2 p.256. Reset 0x0 (DS).</description>
          <addressOffset>0x4</addressOffset>
