          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>EPEna</name>
              <description>Endpoint Enable When set, indicates data is ready. The soft core automatically clears this bit before asserting any of the following interrupts: Endpoint disable Transfer completed [reset 0x0] [access WS/SC]</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>EPDis</name>
              <description>Endpoint disable When set, it forces the data transfer to terminate ( even if the data has not yet ended ) . The soft core automatically clears this bit before setting the Endpoint Disable interrupt. be used after setting EPEna [reset 0x0] [access WS/SC]</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>SetD1PID</name>
              <description>Set DATA1 PID (Intr/Bulk valid ) Set port Data PID value is set to DATA1 [reset 0x0] [access WO]</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>SetD0PID</name>
              <description>Set DATA0 PID (INT/Bulk valid ) Set port Data PID value is set to DATA0 [reset 0x0] [access WO]</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>SNAK</name>
              <description>Set NAK When set, the control port responds with NAK [reset 0x0] [access WO]</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>CNAK</name>
              <description>Clear NAK Clear the SNAK bit [reset 0x0] [access WO]</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>Stall</name>
              <description>Stall handshake ( valid for Non-ISO/CTRL ) After setting, the port only responds to STALL . This bit has higher priority than NAK , Global Non-Periodic IN NAK and Global OUT NAK bit, the application should clear this bit. [reset 0x0] [access RW]</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>Snp</name>
              <description>Snoop Mode In Snoop mode, the soft core does not check whether the OUT packet is correct, but directly reports it to the application [reset 0x0] [access RW]</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EPType</name>
              <description>Port transfer type 'h0: Control 'h1: ISO 'h2: Bulk 'h3: Int [reset 0x0] [access RO]</description>
              <bitOffset>18</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>NAKSts</name>
              <description>NAK status 0 : The soft core sends a non-NAK handshake packet based on the FIFO status 1 : The soft core sends a NAK handshake packet When set, data is transferred as follows: OUT port: The soft core is forced to stop receiving any data; [reset 0x0] [access RO]</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>DPID</name>
              <description>Endpoint Data PID (Intr/Bulk valid ) PID information of the packet that the port is about to receive / send . After the port is enabled, the application must set the SetD0PID or SetD1PID information for a receive / send packet . 0 : DATA0 , 1 : DATA1 [reset 0x0] [access RO]</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>USBActEP</name>
              <description>USB Active Endpoint Indicates whether the port is active under the current configuration and interface descriptor. The application must determine whether to configure this bit based on the SetConfiguration and SetInterface instructions. The soft core detects the USB This bit is automatically cleared after reset [reset 0x0] [access RW/SC]</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MPS</name>
              <description>Maximum Packet Size The software must write the maximum packet length in bytes to this section. [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>11</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
