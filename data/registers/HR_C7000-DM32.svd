              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EnumDoneMsk</name>
              <description>Enumeration Done interrupt mask (dev- only) [reset 0x0] [access RW]</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
