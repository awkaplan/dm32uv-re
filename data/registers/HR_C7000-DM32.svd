              <description>ISO OUT Packet Dropped interrupt (dev- only) When the RxFIFO is insufficient and the soft core cannot receive ISO Triggered when OUT packet [reset 0x0] [access RO/WC]</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>EnumDone</name>
              <description>Enumeration Done interrupt (dev- only) Triggered after speed enumeration is completed. The application must read DSTS to obtain the enumeration result. [reset 0x0] [access RO/WC]</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>USBRst</name>
              <description>USB Reset interrupt (dev- only) Soft core monitoring to USB Triggered after the reset signal [reset 0x0] [access RO/WC]</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>USBSusp</name>
              <description>USB Suspend interrupt (dev- only) Triggered after the soft core detects the suspend state [reset 0x0] [access RO/WC]</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>ErlySusp</name>
              <description>Early Suspend interrupt (dev- only) The soft core is triggered when it detects that the USB bus is in idle state for more than 3ms . [reset 0x0] [access RO/WC]</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>GOUTNakEff</name>
              <description>Global OUT NAK Effective interrupt (dev-only) Triggered when DCTL.SGOUTNak is set, DCTL.CGOUTNak is set Time Clear [reset 0x0] [access RO]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>GINNakEff</name>
              <description>Global IN Non-periodic NAK Effective interrupt (dev- only) DCTL.SGNPInNak is set, cleared when DCTL.CGNPInNak is set [reset 0x0] [access RO]</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RxFv</name>
              <description>RxFIFO Non- Empty Triggered when there is at least one packet data waiting to be read in the RxFIFO [reset 0x0] [access RO]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>Sof</name>
              <description>Start of Frame Interrupt dev mode, the soft core is triggered when it receives SOF , and the application then reads DSTS Get the frame number [reset 0x0] [access RO/WC]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>OTGInt</name>
              <description>OTG interrupt Triggered when an OTG protocol event occurs [reset 0x0] [access RO]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ModeMis</name>
              <description>Mode Mismatch interrupt Triggered when the register in dev mode is used as host mode, and the AHB bus responds OKAY , but the soft core ignores the register access operation [reset 0x0] [access RO/WC]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>CurMod</name>
              <description>Current Mode of Operation 0 : dev , 1 : host [reset 0x0] [access RO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>GINTMSK</name>
