              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_ADC_ERR</name>
              <description>ADC abnormal interrupt enable [reset 0x0] [access RW]</description>
