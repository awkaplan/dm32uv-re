    <peripheral derivedFrom="GPIOA">
      <name>GPIOB</name>
      <description>GPIO bank B (DS Register Table 21). FW: 93 access sites. The keypad row inputs are read here at EXT_PORTA (+0x50).</description>
      <baseAddress>0x14100000</baseAddress>
      <interrupt><name>GPIOB</name><description>PIC source 14 (bit 14 of PIC_MASK/INT_ST), default CPU vector 46 (DS Table 30, p.168-169)</description><value>14</value></interrupt>
    </peripheral>
    <peripheral derivedFrom="GPIOA">
