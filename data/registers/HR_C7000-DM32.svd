            <field>
              <name>ErrticErr</name>
              <description>Uncertain error UTMI PHY status error reports this error, and the software enters the suspended state, and GINTSTS.ErlySusp is set. At this time, the application software can only be restored through soft disconnect [reset 0x0] [access RO]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
