            <field>
              <name>CGOUTNak</name>
              <description>Clear Global OUT NAK Clear Global OUT NAK [reset 0x0] [access WO]</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>SGOUTNak</name>
              <description>Set Global OUT NAK When set, all OUT ports in the soft core should NAK packets Before enabling this bit, be sure to clear GINTSTS.GOUTNakEff [reset 0x0] [access WO]</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>CGNPInNak</name>
              <description>Clear Global Non-periodic IN NAK Clear Global Non-periodic IN NAK bit [reset 0x0] [access WO]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>SGNPInNak</name>
              <description>Set Global Non-periodic IN NAK When set, all IN ports in the soft core should NAK packets Before enabling this bit, be sure to clear GINTSTS.GINNakEff [reset 0x0] [access WO]</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>TstCtl</name>
              <description>Test Controls 'h0 : Test mode is invalid 'h1 : Test J mode 'h2 : Test K mode 'h3 : Test SE0_NAK mode 'h4 : Test Packet mode 'h5 : Test Force_Enable mode Others: Reserved [reset 0x0] [access RW]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>GOUTNakSts</name>
              <description>Global OUT NAK status 0 : A handshake packet has occurred according to the FIFO status and NAK/STAL settings. 1 : No data is written to RxFIOF . Except for SETUP transactions, all packets Reply NAK and discard all ISO OUT . [reset 0x0] [access RO]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>GNPINNakSts</name>
              <description>Global Non-periodic IN NAK state 0 : A handshake packet has occurred according to the FIFO status 1 : All non-periodic IN port responds with NAK [reset 0x0] [access RO]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>SftDiscon</name>
              <description>Soft Disconnect After setting, the soft core is in a disconnected state and no data interaction occurs. [reset 0x0] [access RW]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RmtWkUpSig</name>
              <description>Remote Wakeup Signaling After setting, the soft core initiates a remote signal to wake up the USB The host application must set this bit to exit the soft core suspend state. According to the USB 2.0 specification, the application must clear this bit 1-15ms after setting it . [reset 0x0] [access RW]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
