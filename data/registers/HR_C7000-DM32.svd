            <field>
              <name>dma_req</name>
              <description>DMA Request signal status bit [reset 0x0] [access RO]</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>dma_ack</name>
              <description>DMA Response signal status bit [reset 0x0] [access RO]</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>fifo_count</name>
              <description>The amount of data written into the FIFO [reset 0x0] [access RO]</description>
              <bitOffset>17</bitOffset>
              <bitWidth>13</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>response_index</name>
              <description>Previous reply index number [reset 0x0] [access RO]</description>
              <bitOffset>11</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>data_state_mc_busy</name>
              <description>Data sending or receiving state machine is busy [reset 0x1] [access RO]</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>data_busy</name>
              <description>The opposite value of card_data [0] 0 : Memory card data is not busy; 1 : Memory card data is busy [reset 0x0] [access RO]</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>data_3_status</name>
              <description>Select the storage card card_datap[3] signal to detect whether there is a card. 0 : Memory card present; 1 : No memory card present [reset 0x0] [access RO]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>command_fsm_states</name>
              <description>Indicates the current state of the command state machine: 0- IDLE 1- Send init sequence 2- Tx cmd start bit 3- Tx cmd bit 4- Tx cmd index + arg 5- Tx cmd crc7 6- Tx cmd end bit 7- Rx resp start bit 8- Rx resp IRQ response 9- Rx resp tx bit 10- Rx resp cmd idx 11- Rx resp data 12- Rx resp crc7 13- Rx resp end bit 14- Cmd path wait NCC 15- Wait , CMD_to_response turnaround [reset 0x0] [access RO]</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>fifo_full</name>
              <description>FIFO full flag [reset 0x0] [access RO]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>fifo_empty</name>
              <description>FIFO empty flag [reset 0x1] [access RO]</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>fifo_tx_watermark</name>
              <description>FIFO reaches the send watermark value [reset 0x1] [access RO]</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>fifo_rx_watermark</name>
              <description>FIFO reaches the receive waterline value [reset 0x0] [access RO]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
